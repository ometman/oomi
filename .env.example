# Server-only Vercel environment variables. Never prefix these with PUBLIC_.
GOOGLE_SMTP_USER=hello@ometomeni.org
GOOGLE_APP_PASSWORD=
FORM_DELIVERY_EMAIL=hello@ometomeni.org

# Newsletter: server-only Vercel variables. Configure matching values in Apps Script properties.
GOOGLE_APPS_SCRIPT_NEWSLETTER_URL=
NEWSLETTER_WEBHOOK_SECRET=
NEWSLETTER_FROM_NAME=
NEWSLETTER_REPLY_TO=

# Optional AI drafting is configured in Apps Script properties, not the Astro client.
AI_DRAFT_ENDPOINT=
AI_API_KEY=

# Giving payments
# Keep secret keys in local/Vercel environment variables. Never prefix them with PUBLIC_.
GIVING_SITE_URL=
GIVING_RECEIPT_FROM_NAME=Omet Omeni Ministries
GIVING_FINANCE_NOTIFICATION_EMAIL=

# Mobile Money (Paystack charge API)
MOBILE_MONEY_ENABLED=true
PAYSTACK_SECRET_KEY=
PAYSTACK_WEBHOOK_SECRET=
PAYSTACK_MOBILE_MONEY_CURRENCY=GHS
PAYSTACK_MOBILE_MONEY_PROVIDERS=mtn,atl,vod

# GhanaPay: keep disabled until a contracted provider API is integrated and tested.
GHANAPAY_ENABLED=false
GHANAPAY_API_BASE_URL=
GHANAPAY_API_KEY=
GHANAPAY_API_SECRET=
GHANAPAY_WEBHOOK_SECRET=
GHANAPAY_MERCHANT_ID=
GHANAPAY_MERCHANT_ACCOUNT_NAME=
GHANAPAY_CURRENCY=GHS
PUBLIC_GHANAPAY_NUMBER=
PUBLIC_GHANAPAY_ACCOUNT_NAME=
PUBLIC_GHANAPAY_QR_URL=

# Bank transfer and backend reconciliation
BANK_TRANSFER_ENABLED=false
BANK_TRANSFER_REFERENCE_PREFIX=OOM
BANK_TRANSFER_ALLOWED_CURRENCIES=GHS,USD,GBP,EUR
PUBLIC_BANK_CURRENCY=GHS
PUBLIC_BANK_NAME=
PUBLIC_BANK_ACCOUNT_NAME=
PUBLIC_BANK_ACCOUNT_NUMBER=
PUBLIC_BANK_BRANCH=
PUBLIC_BANK_SWIFT=

# Card: provider-hosted Paystack checkout; never collect card credentials here.
CARD_GIVING_ENABLED=false
CARD_GIVING_CURRENCY=GHS
INTERNATIONAL_GIVING_ENABLED=false

# PayPal Orders API
PAYPAL_GIVING_ENABLED=false
PAYPAL_ENVIRONMENT=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=
PAYPAL_ALLOWED_CURRENCIES=USD,GBP,EUR
