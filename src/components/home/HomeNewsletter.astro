---
import NewsletterSignup from '../newsletter/NewsletterSignup.astro';
---

<section id="stay-connected" class="bg-gradient-to-br from-primary-900 to-neutral-950 py-20 text-white sm:py-24" aria-labelledby="home-newsletter-heading">
  <div class="mx-auto grid max-w-6xl items-start gap-10 px-4 sm:px-6 lg:grid-cols-[0.8fr_1.2fr] lg:px-8">
    <div>
      <p class="text-sm font-semibold uppercase tracking-[0.2em] text-secondary-300">Ministry updates</p>
      <h2 id="home-newsletter-heading" class="mt-3 text-3xl font-display font-bold sm:text-4xl">Stay Connected</h2>
      <p class="mt-5 text-lg leading-relaxed text-neutral-300">Receive selected sermons, prayer programmes, events and ministry updates from Omet Omeni Ministries.</p>
    </div>
    <div class="rounded-2xl border border-white/15 bg-white/10 p-6 shadow-xl backdrop-blur-sm sm:p-8">
      <NewsletterSignup source="HOME" dark title="Choose what you receive" description="Select the updates most relevant to you. You may unsubscribe at any time." />
    </div>
  </div>
</section>
