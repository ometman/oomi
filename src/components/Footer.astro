---
const currentYear = new Date().getFullYear();
---

<footer class="bg-neutral-900 text-white">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-8">
      
      <!-- Church Info -->
      <div class="space-y-4">
        <div class="flex items-center space-x-3">
          <div class="w-10 h-10 bg-gradient-to-br from-primary-500 to-primary-600 rounded-lg flex items-center justify-center">
            <svg class="w-6 h-6 text-white" fill="currentColor" viewBox="0 0 24 24">
              <path d="M12 2L2 7v10c0 5.55 3.84 9.74 9 11 5.16-1.26 9-5.45 9-11V7l-10-5z"/>
            </svg>
          </div>
          <div>
            <h3 class="text-lg font-bold">Omet Omeni Ministries</h3>
            <p class="text-sm text-neutral-300">Preaching and Teaching Jesus Christ</p>
          </div>
        </div>
        <p class="text-neutral-300 text-sm leading-relaxed">
          A vibrant Christian community dedicated to faith, fellowship, and spiritual growth in Kumasi, Ghana.
        </p>
      </div>

      <!-- Contact Info -->
      <div class="space-y-4">
        <h4 class="text-lg font-semibold">Contact Us</h4>
        <div class="space-y-3 text-sm text-neutral-300">
          <div class="flex items-start space-x-3">
            <svg class="w-5 h-5 mt-0.5 text-secondary-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
            </svg>
            <div>
              <p>Conference Hall</p>
              <p>Royal Cockpit Hotel</p>
              <p>Ahodwo-Nhyiaeso, Kumasi</p>
              <p>Ghana</p>
            </div>
          </div>
          <div class="flex items-center space-x-3">
            <svg class="w-5 h-5 text-secondary-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
            </svg>
            <a href="mailto:hello@ometomeni.org" class="hover:text-secondary-400 transition-colors">hello@ometomeni.org</a>
          </div>
        </div>
      </div>

      <!-- Service Times -->
      <div class="space-y-4">
        <h4 class="text-lg font-semibold">Service Times</h4>
        <div class="space-y-3 text-sm text-neutral-300">
          <div>
            <p class="font-medium text-white">Sunday Service</p>
            <p>9:00 AM - 11:30 AM</p>
          </div>
          <div>
            <p class="font-medium text-white">Bible Study</p>
            <p>Wednesday 6:00 PM</p>
          </div>
          <div>
            <p class="font-medium text-white">Prayer Meeting</p>
            <p>Friday 6:00 PM</p>
          </div>
          <div>
            <p class="font-medium text-white">Youth Service</p>
            <p>Saturday 4:00 PM</p>
          </div>
        </div>
      </div>

      <!-- Quick Links & Social -->
      <div class="space-y-4">
        <h4 class="text-lg font-semibold">Follow Us</h4>
        <div class="flex space-x-4">
          <a href="https://www.facebook.com/oominternational" target="_blank" rel="noopener noreferrer" class="text-neutral-400 hover:text-secondary-400 transition-colors">
            <span class="sr-only">Facebook</span>
            <svg class="w-6 h-6" fill="currentColor" viewBox="0 0 24 24">
              <path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/>
            </svg>
          </a>
          <a href="https://www.instagram.com/oominternational" target="_blank" rel="noopener noreferrer" class="text-neutral-400 hover:text-secondary-400 transition-colors">
            <span class="sr-only">Instagram</span>
            <svg class="w-6 h-6" fill="currentColor" viewBox="0 0 24 24">
              <path d="M12.017 0C5.396 0 .029 5.367.029 11.987c0 6.62 5.367 11.987 11.988 11.987 6.62 0 11.987-5.367 11.987-11.987C24.014 5.367 18.637.001 12.017.001zM8.449 16.988c-1.297 0-2.448-.49-3.324-1.297L12.017 8.8l6.892 6.891c-.876.807-2.027 1.297-3.324 1.297H8.449z"/>
            </svg>
          </a>
          <a href="https://www.youtube.com/@oominternational" target="_blank" rel="noopener noreferrer" class="text-neutral-400 hover:text-secondary-400 transition-colors">
            <span class="sr-only">YouTube</span>
            <svg class="w-6 h-6" fill="currentColor" viewBox="0 0 24 24">
              <path d="M23.498 6.186a3.016 3.016 0 0 0-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 0 0 .502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 0 0 2.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 0 0 2.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z"/>
            </svg>
          </a>
        </div>
        
        <!-- Newsletter Signup -->
        <div class="pt-4">
          <h5 class="text-sm font-semibold mb-2">Stay Connected</h5>
          <form class="space-y-2">
            <input 
              type="email" 
              placeholder="Your email address"
              class="w-full px-3 py-2 text-sm bg-neutral-800 border border-neutral-700 rounded-lg text-white placeholder-neutral-400 focus:outline-none focus:ring-2 focus:ring-primary-500 focus:border-transparent"
            />
            <button 
              type="submit"
              class="w-full bg-primary-600 text-white px-3 py-2 text-sm rounded-lg hover:bg-primary-700 transition-colors focus:outline-none focus:ring-2 focus:ring-primary-500"
            >
              Subscribe
            </button>
          </form>
        </div>
      </div>
    </div>

    <!-- Bottom Bar -->
    <div class="border-t border-neutral-800 mt-8 pt-8 flex flex-col sm:flex-row justify-between items-center">
      <p class="text-sm text-neutral-400">
        © {currentYear} Omet Omeni Ministries. All rights reserved.
      </p>
      <div class="flex space-x-6 mt-4 sm:mt-0">
        <a href="/privacy" class="text-sm text-neutral-400 hover:text-white transition-colors">Privacy Policy</a>
        <a href="/terms" class="text-sm text-neutral-400 hover:text-white transition-colors">Terms of Service</a>
      </div>
    </div>
  </div>
</footer>
