---
import type { FeaturedProgramme } from '../../data/events';

interface Props {
  programme: FeaturedProgramme;
}

const { programme } = Astro.props;
---

<article
  class="flex h-full flex-col overflow-hidden rounded-2xl border border-primary-100 bg-white shadow-[0_20px_60px_-38px_rgba(30,58,138,0.55)]"
  data-event-card
  data-featured-event
  data-location={programme.filterLocations.join(' ')}
  data-format={programme.filterFormat}
  data-category={programme.filterCategory}
  data-month={programme.date.slice(0, 7)}
>
  <div class="relative flex h-64 items-center justify-center overflow-hidden bg-gradient-to-br from-primary-950 via-primary-800 to-secondary-500 sm:h-72">
    {programme.image
      ? <img src={programme.image} alt="" loading="lazy" width="800" height="520" class="absolute inset-0 h-full w-full object-cover" />
      : <div class="relative text-center text-white">
          <svg aria-hidden="true" class="mx-auto h-12 w-12 opacity-80" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
            <path stroke-linecap="round" stroke-linejoin="round" d="m2.25 15.75 5.159-5.159a2.25 2.25 0 0 1 3.182 0l5.159 5.159m-1.5-1.5 1.409-1.409a2.25 2.25 0 0 1 3.182 0l2.909 2.909m-18 3.75h16.5a1.5 1.5 0 0 0 1.5-1.5V6a1.5 1.5 0 0 0-1.5-1.5H3.75A1.5 1.5 0 0 0 2.25 6v12a1.5 1.5 0 0 0 1.5 1.5Z" />
          </svg>
          <p class="mt-3 text-sm font-semibold uppercase tracking-[0.18em]">Event photo</p>
        </div>}
    <div class="absolute inset-0 bg-gradient-to-t from-neutral-950/45 to-transparent"></div>
  </div>

  <div class="flex flex-1 flex-col p-7 sm:p-8">
    <div class="flex flex-wrap gap-2 text-xs font-semibold uppercase tracking-wider">
      <span class="rounded-full bg-secondary-100 px-3 py-1 text-secondary-900">{programme.category}</span>
      <span class="rounded-full bg-primary-100 px-3 py-1 text-primary-900">{programme.format}</span>
    </div>
    <h3 class="mt-5 text-2xl font-display font-bold text-neutral-900 sm:text-3xl">{programme.title}</h3>
    <time datetime={programme.date} class="mt-3 text-base font-bold text-secondary-800">{programme.dateLabel}</time>
    <p class="mt-3 font-semibold leading-relaxed text-primary-800">{programme.theme}</p>
    <p class="mt-4 flex-1 leading-relaxed text-neutral-600">{programme.description}</p>
    <p class="mt-5 text-sm font-medium text-neutral-700">
      <span class="font-semibold">Location:</span> {programme.locations.join(' and ')}
    </p>
    <div class="mt-7">
      <button
        type="button"
        data-event-response
        data-action={programme.ctaLabel.toLowerCase().includes('register') ? 'REGISTER' : 'PLAN'}
        data-programme={programme.title}
        data-meta={`${programme.dateLabel} · ${programme.format} · ${programme.locations.join(' and ')}`}
        data-description={`${programme.theme}. ${programme.description}`}
        class="inline-flex min-h-11 items-center justify-center rounded-lg bg-primary-700 px-5 py-3 font-semibold text-white hover:bg-primary-800 focus:outline-none focus:ring-2 focus:ring-primary-500"
      >
        {programme.ctaLabel}
      </button>
    </div>
  </div>
</article>
