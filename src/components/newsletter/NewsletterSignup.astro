---
interface Props {
  source: string;
  title?: string;
  description?: string;
  defaultInterests?: string[];
  compact?: boolean;
  dark?: boolean;
}

const {
  source,
  title = 'Stay connected',
  description = 'Receive selected ministry updates, teachings, prayer programmes and events.',
  defaultInterests = ['GENERAL_UPDATES'],
  compact = false,
  dark = false,
} = Astro.props;
const id = `newsletter-${source.toLowerCase().replace(/[^a-z0-9]+/g, '-')}`;
const inputClass = dark
  ? 'w-full rounded-lg border border-neutral-600 bg-neutral-800 px-3 py-2 text-sm text-white placeholder-neutral-400 focus:border-primary-400 focus:outline-none focus:ring-2 focus:ring-primary-400'
  : 'w-full rounded-lg border border-neutral-300 bg-white px-4 py-3 text-neutral-900 focus:border-primary-500 focus:outline-none focus:ring-2 focus:ring-primary-500';
const interests = [
  ['SERMONS_TEACHINGS', 'Sermons and teachings'], ['PRAYER_PROGRAMMES', 'Prayer programmes'],
  ['EVENTS', 'Events'], ['LEADERSHIP_RESOURCES', 'Leadership resources'],
  ['DISCIPLESHIP', 'Discipleship'], ['GENERAL_UPDATES', 'General Ministry'],
];
---

<div class:list={['newsletter-signup', compact ? 'space-y-3' : 'space-y-6']}>
  <div>
    <h3 class:list={[compact ? 'text-sm font-semibold' : 'text-2xl font-display font-bold', dark ? 'text-white' : 'text-neutral-900']}>{title}</h3>
    <p class:list={[compact ? 'mt-1 text-xs' : 'mt-2 text-base', dark ? 'text-neutral-300' : 'text-neutral-600']}>{description}</p>
  </div>

  <form class="newsletter-form space-y-4" data-source={source} novalidate>
    <div class="absolute -left-[10000px]" aria-hidden="true">
      <label for={`${id}-company`}>Leave this field empty</label>
      <input id={`${id}-company`} name="company" type="text" tabindex="-1" autocomplete="off" />
    </div>

    <div class:list={compact ? 'space-y-3' : 'grid grid-cols-1 sm:grid-cols-2 gap-4'}>
      <div>
        <label for={`${id}-first-name`} class:list={['block text-sm font-medium mb-1', dark ? 'text-neutral-200' : 'text-neutral-700']}>First name *</label>
        <input id={`${id}-first-name`} name="firstName" autocomplete="given-name" maxlength="80" required class={inputClass} />
        <p class="mt-1 text-sm text-red-600" data-error-for="firstName"></p>
      </div>
      <div>
        <label for={`${id}-email`} class:list={['block text-sm font-medium mb-1', dark ? 'text-neutral-200' : 'text-neutral-700']}>Email address *</label>
        <input id={`${id}-email`} name="email" type="email" autocomplete="email" maxlength="254" required class={inputClass} />
        <p class="mt-1 text-sm text-red-600" data-error-for="email"></p>
      </div>
    </div>

    <details class:list={['rounded-lg border p-3', dark ? 'border-neutral-700 bg-neutral-800/50' : 'border-neutral-200 bg-neutral-50']}>
      <summary class:list={['cursor-pointer text-sm font-medium', dark ? 'text-neutral-200' : 'text-neutral-700']}>Optional preferences</summary>
      <div class="mt-4 space-y-5">
        <div class="grid grid-cols-1 gap-4 sm:grid-cols-2">
          <div><label for={`${id}-whatsapp`} class:list={['block text-sm mb-1', dark ? 'text-neutral-300' : 'text-neutral-700']}>WhatsApp No.</label><input id={`${id}-whatsapp`} name="whatsapp" type="tel" autocomplete="tel" class={inputClass} /><p class="mt-1 text-sm text-red-600" data-error-for="whatsapp"></p></div>
          <div><label for={`${id}-location`} class:list={['block text-sm mb-1', dark ? 'text-neutral-300' : 'text-neutral-700']}>Location</label><select id={`${id}-location`} name="location" class={inputClass}><option value="">Choose</option><option value="ACCRA">Accra</option><option value="KUMASI">Kumasi</option><option value="ONLINE">International</option><option value="OTHER">Other</option></select></div>
        </div>
        <fieldset>
          <legend class:list={['text-sm font-medium', dark ? 'text-neutral-200' : 'text-neutral-700']}>What would you like to receive?</legend>
          <div class="mt-2 space-y-2">
            {interests.map(([value, label]) => <label class:list={['flex gap-2 text-sm', dark ? 'text-neutral-300' : 'text-neutral-700']}><input type="checkbox" name="interests" value={value} checked={defaultInterests.includes(value)} class="mt-0.5 h-4 w-4 rounded text-primary-600 focus:ring-primary-500" /> <span>{label}</span></label>)}
          </div>
        </fieldset>
      </div>
    </details>

    <label class:list={['flex items-start gap-2 text-sm', dark ? 'text-neutral-300' : 'text-neutral-700']}>
      <input name="consentGiven" type="checkbox" required class="mt-1 h-4 w-4 flex-none rounded text-primary-600 focus:ring-primary-500" />
      <span>By subscribing, you agree to receive email updates from Omet Omeni Ministries. You may unsubscribe at any time. *</span>
    </label>
    <p class="text-sm text-red-600" data-error-for="consentGiven"></p>

    <button type="submit" class:list={['rounded-lg bg-primary-600 px-5 py-3 font-semibold text-white hover:bg-primary-700 disabled:cursor-not-allowed disabled:opacity-60 focus:outline-none focus:ring-2 focus:ring-primary-500 focus:ring-offset-2', compact ? 'w-full text-sm' : 'w-full sm:w-auto']}>
      Subscribe
    </button>
    <p class:list={['newsletter-status text-sm', dark ? 'text-neutral-300' : 'text-neutral-600']} role="status" aria-live="polite"></p>
  </form>
</div>

<script>
  import { validateNewsletterSubscription } from '../../lib/newsletter';

  document.querySelectorAll<HTMLFormElement>('.newsletter-form').forEach((form) => {
    if (form.dataset.initialized === 'true') return;
    form.dataset.initialized = 'true';
    form.addEventListener('submit', async (event) => {
      event.preventDefault();
      const button = form.querySelector<HTMLButtonElement>('button[type="submit"]')!;
      const status = form.querySelector<HTMLElement>('.newsletter-status')!;
      form.querySelectorAll<HTMLElement>('[data-error-for]').forEach((node) => { node.textContent = ''; });
      const data = new FormData(form);
      const payload = {
        firstName: data.get('firstName'), email: data.get('email'), whatsapp: data.get('whatsapp'),
        location: data.get('location'), interests: data.getAll('interests'), consentGiven: data.get('consentGiven') === 'on',
        company: data.get('company'), source: form.dataset.source || 'WEBSITE',
      };
      const validation = validateNewsletterSubscription(payload);
      if (!validation.valid) {
        Object.entries(validation.errors).forEach(([field, message]) => {
          const node = form.querySelector<HTMLElement>(`[data-error-for="${field}"]`); if (node) node.textContent = message;
        });
        status.className = 'newsletter-status text-sm text-red-600';
        status.textContent = 'Please review the highlighted fields.';
        form.querySelector<HTMLElement>('[data-error-for]:not(:empty)')?.parentElement?.querySelector<HTMLElement>('input, select')?.focus();
        return;
      }
      button.disabled = true; button.textContent = 'Subscribing…';
      status.className = 'newsletter-status text-sm text-neutral-600'; status.textContent = 'Saving your preferences…';
      try {
        const response = await fetch('/api/newsletter/subscribe', {
          method: 'POST', headers: { 'Content-Type': 'application/json', Accept: 'application/json' }, body: JSON.stringify(payload),
        });
        const result = await response.json().catch(() => ({}));
        if (!response.ok || !['ACTIVE', 'DUPLICATE', 'REACTIVATED'].includes(result.status)) throw new Error();
        form.reset();
        status.className = 'newsletter-status text-sm font-medium text-green-600';
        status.textContent = result.status === 'DUPLICATE'
          ? 'You are already subscribed. We kept your existing preferences.'
          : 'Thank you for subscribing. Please check your email for a welcome message and ministry updates.';
      } catch {
        status.className = 'newsletter-status text-sm font-medium text-red-600';
        status.textContent = 'We could not complete your subscription. Your entries are still available; please try again later.';
      } finally {
        button.disabled = false; button.textContent = 'Subscribe';
      }
    });
  });
</script>
