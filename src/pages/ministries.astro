---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import portrait from '../assets/ometomeni-portrait.png';
import { categoryLabels, featuredMinistries, locationLabels, ministries, statusLabels } from '../data/ministries';
import { ministryFilters } from '../data/ministryFilters';
import { volunteerOpportunities } from '../data/volunteerOpportunities';

const interest = Astro.url.searchParams.get('interest') ?? Astro.url.searchParams.get('role') ?? '';
const fieldClass = 'w-full rounded-lg border border-neutral-300 bg-white px-4 py-3 text-neutral-900 transition-colors focus:border-primary-600 focus:outline-none focus:ring-2 focus:ring-primary-500';
const ministryOptions = [...ministries.map(({ title, slug }) => ({ title, slug })), { title: 'Not Sure', slug: 'not-sure' }];
const directoryMinistries = ministries.filter(({ slug }) => !['discipleship', 'prayer-support', 'outreach-support'].includes(slug));
---

<Layout
  title="Ministries & Involvement | Omet Omeni Ministries"
  description="Explore Omet Omeni Ministries programmes and service opportunities in biblical teaching, prayer, discipleship, leadership, outreach and digital ministry across Accra, Kumasi and online."
>
  <Header />
  <main>
    <section class="relative isolate flex min-h-[42rem] items-center overflow-hidden bg-neutral-950 py-20">
      <img
        src="/images/ministries/oom-people-at-work-2.png"
        alt="Ministry teams welcoming people, coordinating programmes and supporting media production"
        width="1680"
        height="945"
        fetchpriority="high"
        class="absolute inset-0 -z-20 h-full w-full object-cover object-center"
      />
      <div
        class="absolute inset-0 -z-10"
        style="background: linear-gradient(90deg, rgb(10 10 10 / 42%) 0%, rgb(10 10 10 / 70%) 32%, rgb(10 10 10 / 78%) 50%, rgb(10 10 10 / 70%) 68%, rgb(10 10 10 / 42%) 100%);"
        aria-hidden="true"
      ></div>
      <div class="absolute inset-0 -z-10 bg-gradient-to-t from-neutral-950/70 via-neutral-950/20 to-neutral-950/35" aria-hidden="true"></div>
      <div class="mx-auto w-full max-w-7xl px-4 sm:px-6 lg:px-8">
        <div class="mx-auto max-w-4xl text-center">
        <p class="mb-4 text-sm font-semibold uppercase tracking-[0.22em] text-secondary-300">Grow, participate and serve</p>
        <h1 class="mx-auto mb-6 max-w-3xl font-display text-4xl font-bold text-white sm:text-5xl lg:text-6xl">
          Ministries &amp; <span class="bg-gradient-to-r from-secondary-200 to-secondary-400 bg-clip-text text-transparent">Involvement</span>
        </h1>
        <p class="mx-auto mb-10 max-w-2xl text-lg leading-relaxed text-neutral-100 sm:text-xl">Discover how Omet Omeni Ministries serves through biblical teaching, prayer, discipleship, leadership development, outreach and digital ministry in Accra, Kumasi and online.</p>
        <div class="mx-auto grid max-w-3xl grid-cols-1 gap-4 sm:grid-cols-3">
          {['Purposeful Ministries', 'Join Passionate Teams', 'Volunteering Available'].map((title, index) => (
            <div class="flex min-h-24 items-center justify-center rounded-xl border border-white/20 bg-neutral-950/60 p-4 text-center shadow-lg backdrop-blur-sm">
              <p class={`text-lg font-bold leading-snug ${index === 1 ? 'text-secondary-300' : 'text-primary-200'}`}>{title}</p>
            </div>
          ))}
        </div>
        </div>
      </div>
    </section>

    <section class="bg-white py-20" aria-labelledby="featured-heading">
      <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
        <div class="mb-16 text-center">
          <h2 id="featured-heading" class="mb-4 font-display text-3xl font-bold text-neutral-900 sm:text-4xl">Featured Ministries</h2>
          <p class="text-xl text-neutral-600">Explore public programmes and pathways for Christian growth.</p>
        </div>
        <div class="grid grid-cols-1 gap-7 md:grid-cols-2 lg:grid-cols-3">
          {featuredMinistries.map((ministry, index) => (
            <article class="overflow-hidden rounded-2xl border border-neutral-100 bg-white shadow-xl transition-shadow duration-300 hover:shadow-2xl">
              <div class="relative h-52">
                <img src={ministry.image} alt="" width="800" height="450" loading={index > 1 ? 'lazy' : 'eager'} class="h-full w-full object-cover" />
                <div class="absolute inset-0 bg-black/40"></div>
                <div class="absolute bottom-4 left-4 right-4 flex items-center justify-between gap-2">
                  <span class="rounded-full bg-primary-700 px-3 py-1 text-sm font-medium text-white">{categoryLabels[ministry.category]}</span>
                  <span class="rounded-full bg-white/95 px-3 py-1 text-sm font-medium text-neutral-900">{statusLabels[ministry.status]}</span>
                </div>
              </div>
              <div class="p-6">
                <h3 class="mb-3 text-xl font-bold text-neutral-900">{ministry.title}</h3>
                <dl class="mb-4 space-y-2 text-sm text-neutral-600">
                  <div class="flex gap-2"><dt class="font-semibold text-neutral-800">Focus:</dt><dd>{ministry.focus}</dd></div>
                  <div class="flex gap-2"><dt class="font-semibold text-neutral-800">Format:</dt><dd>{ministry.format}</dd></div>
                  <div class="flex gap-2"><dt class="font-semibold text-neutral-800">Participation:</dt><dd>{ministry.participationLabel}</dd></div>
                </dl>
                <p class="mb-6 leading-relaxed text-neutral-600">{ministry.description}</p>
                <div class="mb-6">
                  <h4 class="mb-3 font-semibold text-neutral-900">What We Do</h4>
                  <ul class="space-y-1">
                    {ministry.activities.slice(0, 3).map((activity) => (
                      <li class="flex items-start text-sm text-neutral-600"><span class="mr-2 mt-0.5 text-primary-700" aria-hidden="true">✓</span>{activity}</li>
                    ))}
                  </ul>
                </div>
                <a href={`/ministries/${ministry.slug}`} class={`block w-full rounded-lg px-6 py-3 text-center font-semibold text-white focus:outline-none focus:ring-2 focus:ring-offset-2 ${index % 2 ? 'bg-secondary-700 hover:bg-secondary-800 focus:ring-secondary-600' : 'bg-primary-700 hover:bg-primary-800 focus:ring-primary-600'}`}>Explore Ministry</a>
              </div>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="bg-neutral-50 py-20" aria-labelledby="directory-heading">
      <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
        <div class="mb-10 text-center">
          <h2 id="directory-heading" class="mb-4 font-display text-3xl font-bold text-neutral-900 sm:text-4xl">All Ministries and Service Teams</h2>
          <p class="mb-8 text-xl text-neutral-600">Explore our public ministry expressions and the operational teams that support them.</p>
          <div id="ministry-filters" class="flex flex-wrap justify-center gap-3" aria-label="Filter ministries">
            {ministryFilters.map((filter, index) => (
              <button type="button" class="filter-btn rounded-full border border-neutral-300 bg-white px-4 py-2 text-sm font-medium text-black text-neutral-800 transition-colors hover:border-primary-500 hover:bg-primary-50 focus:outline-none focus:ring-2 focus:ring-primary-600 focus:ring-offset-2" data-filter-attribute={filter.attribute} data-filter-value={filter.value} aria-pressed={index === 0 ? 'true' : 'false'}>
                <span aria-hidden="true" class="filter-check mr-1">{index === 0 ? '✓' : ''}</span>{filter.label}
              </button>
            ))}
            <button id="clear-filters" type="button" class="rounded-full border border-neutral-400 px-4 py-2 text-sm font-semibold text-neutral-800 underline decoration-secondary-500 underline-offset-4 focus:outline-none focus:ring-2 focus:ring-primary-600 focus:ring-offset-2">Clear Filters</button>
          </div>
          <p id="filter-result-count" class="mt-5 font-medium text-neutral-700" role="status" aria-live="polite">{directoryMinistries.length} ministries and teams shown</p>
        </div>
        <div id="ministries-grid" class="grid grid-cols-1 gap-8 md:grid-cols-2 lg:grid-cols-3">
          {directoryMinistries.map((ministry) => (
            <article class="ministry-card overflow-hidden rounded-xl bg-white shadow-lg transition-shadow duration-300 hover:shadow-xl" data-category={ministry.category} data-location={ministry.locations.join(' ')} data-volunteer-status={String(ministry.acceptingVolunteers)}>
              <div class="relative h-48">
                <img src={ministry.thumbnail} alt="" width="640" height="360" loading="lazy" class="h-full w-full object-cover" />
                <span class="absolute left-3 top-3 rounded-full bg-white/95 px-2 py-1 text-xs font-medium text-neutral-900">{categoryLabels[ministry.category]}</span>
                <span class="absolute right-3 top-3 rounded bg-neutral-900/85 px-2 py-1 text-xs font-medium text-white">{statusLabels[ministry.status]}</span>
              </div>
              <div class="p-6">
                <h3 class="mb-2 text-lg font-semibold text-neutral-900">{ministry.title}</h3>
                <dl class="mb-3 space-y-1 text-sm text-neutral-600">
                  <div class="flex gap-1"><dt class="font-semibold">Type:</dt><dd>{categoryLabels[ministry.category]}</dd></div>
                  <div class="flex gap-1"><dt class="font-semibold">Availability:</dt><dd>{ministry.locations.map((location) => locationLabels[location]).join(', ')}</dd></div>
                </dl>
                <p class="mb-4 line-clamp-3 text-sm text-neutral-600">{ministry.description}</p>
                <div class="flex items-center justify-between gap-4">
                  <span class="text-xs text-neutral-600">{ministry.participationLabel}</span>
                  <a href={`/ministries/${ministry.slug}`} class="text-sm font-semibold text-primary-700 underline decoration-secondary-500 underline-offset-4 focus:outline-none focus:ring-2 focus:ring-primary-600">Learn More <span aria-hidden="true">→</span></a>
                </div>
              </div>
            </article>
          ))}
        </div>
        <div id="filter-empty-state" class="hidden rounded-2xl border border-neutral-200 bg-white p-10 text-center shadow-sm" role="status">
          <h3 class="text-xl font-semibold text-neutral-900">No matching ministries or teams</h3>
          <p class="mt-2 text-neutral-600">Clear the current filter to explore every ministry and team.</p>
        </div>
      </div>
    </section>

    <section class="bg-white py-20" aria-labelledby="leadership-heading">
      <div class="mx-auto max-w-6xl px-4 sm:px-6 lg:px-8">
        <div class="mb-16 text-center">
          <h2 id="leadership-heading" class="mb-4 font-display text-3xl font-bold text-neutral-900 sm:text-4xl">Ministry Leadership and Oversight</h2>
          <p class="text-xl text-neutral-600">Spiritual oversight and coordinated support for responsible ministry.</p>
        </div>
        <div class="grid gap-8 md:grid-cols-2">
          <article class="overflow-hidden rounded-2xl border border-neutral-100 bg-white shadow-xl sm:flex">
            <img src={portrait.src} alt="Rev. Omet Yawelis Omeni" width={portrait.width} height={portrait.height} loading="lazy" class="h-72 w-full object-cover object-top sm:h-auto sm:w-2/5" />
            <div class="p-8">
              <h3 class="text-2xl font-bold text-neutral-900">Rev. Omet Yawelis Omeni</h3>
              <p class="mt-1 font-semibold text-primary-700">Founder and Ministry Lead</p>
              <p class="mt-2 text-sm font-medium text-neutral-600">Spiritual and Strategic Oversight</p>
              <p class="mt-5 leading-relaxed text-neutral-600">Rev. Omet Yawelis Omeni provides spiritual and strategic oversight for Omet Omeni Ministries. His ministry focus includes biblical teaching, prayer, discipleship, leadership development and online outreach.</p>
            </div>
          </article>
          <article class="rounded-2xl border border-secondary-200 bg-gradient-to-br from-primary-50 to-secondary-50 p-8 shadow-lg">
            <div class="flex h-14 w-14 items-center justify-center rounded-xl bg-secondary-700 text-white" aria-hidden="true">
              <svg class="h-7 w-7" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5-2.2M7 20H2v-2a3 3 0 015-2.2M12 13a4 4 0 100-8 4 4 0 000 8zm0 2a6 6 0 00-6 5h12a6 6 0 00-6-5z"/></svg>
            </div>
            <h3 class="mt-6 text-2xl font-bold text-neutral-900">Ministry Leadership and Coordination Team</h3>
            <p class="mt-4 leading-relaxed text-neutral-700">Approved ministry coordinators, administrators and volunteers support programme delivery in Accra, Kumasi and online.</p>
            <p class="mt-4 text-sm text-neutral-600">Doctrine, prophecy, testimonies, care-sensitive content and financial appeals follow ministry review and safeguarding processes before publication or delivery.</p>
          </article>
        </div>
      </div>
    </section>

    <section class="bg-gradient-to-br from-primary-50 to-secondary-50 py-20" aria-labelledby="volunteer-heading">
      <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
        <div class="mb-16 text-center">
          <h2 id="volunteer-heading" class="mb-4 font-display text-3xl font-bold text-neutral-900 sm:text-4xl">Volunteer Opportunities</h2>
          <p class="text-xl text-neutral-600">Express interest in serving; all roles are reviewed and placement is not automatic.</p>
        </div>
        <div class="grid grid-cols-1 gap-8 md:grid-cols-2">
          {volunteerOpportunities.map((opportunity, index) => (
            <article class="rounded-2xl bg-white p-8 shadow-lg transition-shadow duration-300 hover:shadow-xl">
              <div class="flex items-start">
                <div class={`mr-4 flex h-12 w-12 flex-shrink-0 items-center justify-center rounded-xl ${index % 2 ? 'bg-secondary-100 text-secondary-700' : 'bg-primary-100 text-primary-700'}`} aria-hidden="true">♡</div>
                <div class="flex-1">
                  <div class="flex flex-wrap items-center justify-between gap-2"><h3 class="text-xl font-semibold text-neutral-900">{opportunity.title}</h3><span class="rounded-full bg-neutral-100 px-2 py-1 text-xs font-semibold text-neutral-700">{opportunity.status}</span></div>
                  <p class="my-4 text-neutral-600">{opportunity.description}</p>
                  <dl class="mb-5 space-y-2 text-sm text-neutral-600">
                    <div><dt class="inline font-semibold text-neutral-800">Commitment:</dt> <dd class="inline">{opportunity.commitment}</dd></div>
                    <div><dt class="inline font-semibold text-neutral-800">Helpful skills:</dt> <dd class="inline">{opportunity.skills}</dd></div>
                  </dl>
                  <a href={`#ministry-application`} data-interest={opportunity.slug} class={`inline-flex rounded-lg px-4 py-2 font-medium text-white focus:outline-none focus:ring-2 focus:ring-offset-2 ${index % 2 ? 'bg-secondary-700 hover:bg-secondary-800 focus:ring-secondary-600' : 'bg-primary-700 hover:bg-primary-800 focus:ring-primary-600'}`}>Express Interest</a>
                </div>
              </div>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section id="ministry-application" class="scroll-mt-24 bg-white py-20" aria-labelledby="application-heading">
      <div class="mx-auto max-w-4xl px-4 sm:px-6 lg:px-8">
        <div class="rounded-2xl bg-gradient-to-br from-primary-50 to-secondary-50 p-8 lg:p-12">
          <div class="mb-8 text-center">
            <h2 id="application-heading" class="mb-4 font-display text-3xl font-bold text-neutral-900">Ministry Application</h2>
            <p class="text-xl text-neutral-600">Express interest in serving with a ministry or operational team. Submissions are reviewed before any next step or placement.</p>
          </div>
          <form class="space-y-6" id="ministry-form" novalidate>
            <div class="absolute -left-[10000px]" aria-hidden="true"><label for="ministry-company">Leave this field empty</label><input id="ministry-company" name="company" type="text" tabindex="-1" autocomplete="off" /></div>
            <div id="form-errors" class="hidden rounded-lg border border-red-300 bg-red-50 p-4 text-sm text-red-800" role="alert" tabindex="-1"></div>
            <div class="grid grid-cols-1 gap-6 md:grid-cols-2">
              <div><label for="first-name" class="mb-2 block text-sm font-medium text-neutral-700">First Name *</label><input class={fieldClass} id="first-name" name="firstName" autocomplete="given-name" required /><p class="field-error mt-1 text-sm text-red-700" data-error-for="firstName"></p></div>
              <div><label for="last-name" class="mb-2 block text-sm font-medium text-neutral-700">Last Name *</label><input class={fieldClass} id="last-name" name="lastName" autocomplete="family-name" required /><p class="field-error mt-1 text-sm text-red-700" data-error-for="lastName"></p></div>
              <div><label for="email" class="mb-2 block text-sm font-medium text-neutral-700">Email Address *</label><input class={fieldClass} type="email" id="email" name="email" autocomplete="email" required /><p class="field-error mt-1 text-sm text-red-700" data-error-for="email"></p></div>
              <div><label for="phone" class="mb-2 block text-sm font-medium text-neutral-700">Phone or WhatsApp</label><input class={fieldClass} type="tel" id="phone" name="phone" autocomplete="tel" /></div>
              <div><label for="location-preference" class="mb-2 block text-sm font-medium text-neutral-700">Location preference *</label><select class={fieldClass} id="location-preference" name="locationPreference" required><option value="">Choose a location</option>{['Accra', 'Kumasi', 'Online', 'Flexible', 'Other'].map((option) => <option value={option}>{option}</option>)}</select><p class="field-error mt-1 text-sm text-red-700" data-error-for="locationPreference"></p></div>
              <div><label for="contact-method" class="mb-2 block text-sm font-medium text-neutral-700">Preferred contact method *</label><select class={fieldClass} id="contact-method" name="preferredContactMethod" required><option value="">Choose a method</option>{['WhatsApp', 'Phone', 'Email'].map((option) => <option value={option}>{option}</option>)}</select><p class="field-error mt-1 text-sm text-red-700" data-error-for="preferredContactMethod"></p></div>
            </div>
            <div><label for="ministry-interest" class="mb-2 block text-sm font-medium text-neutral-700">Ministry interest *</label><select class={fieldClass} id="ministry-interest" name="ministryInterest" required><option value="">Choose a ministry or team</option>{ministryOptions.map((option) => <option value={option.slug} selected={interest === option.slug}>{option.title}</option>)}</select><p class="field-error mt-1 text-sm text-red-700" data-error-for="ministryInterest"></p></div>
            <div><label for="skills" class="mb-2 block text-sm font-medium text-neutral-700">Skills and experience</label><textarea class={fieldClass} id="skills" name="skills" rows="3" placeholder="Share relevant skills or areas you would like to develop."></textarea></div>
            <fieldset><legend class="mb-3 text-sm font-medium text-neutral-700">Availability</legend><div class="grid grid-cols-2 gap-3 md:grid-cols-3">{['Occasional', 'Event-based', 'Weekly', 'Monthly', 'Flexible', 'Remote'].map((option) => <label class="flex items-center gap-2"><input type="checkbox" name="availability" value={option} class="h-4 w-4 rounded border-neutral-300 text-primary-700 focus:ring-primary-600" /> <span class="text-sm">{option}</span></label>)}</div></fieldset>
            <div><label for="message" class="mb-2 block text-sm font-medium text-neutral-700">Additional information</label><textarea class={fieldClass} id="message" name="message" rows="4" placeholder="Tell us anything helpful for reviewing your expression of interest. Please do not include private prayer, medical or safeguarding disclosures here."></textarea></div>
            <div class="space-y-4">
              <label class="flex items-start gap-3"><input id="placement-acknowledgement" name="placementAcknowledgement" type="checkbox" required class="mt-1 h-4 w-4 rounded border-neutral-300 text-primary-700 focus:ring-primary-600" /><span class="text-sm text-neutral-700">I understand that submitting this form does not guarantee placement in a ministry role. *</span></label><p class="field-error text-sm text-red-700" data-error-for="placementAcknowledgement"></p>
              <label class="flex items-start gap-3"><input id="ministry-consent" name="contactConsent" type="checkbox" required class="mt-1 h-4 w-4 rounded border-neutral-300 text-primary-700 focus:ring-primary-600" /><span class="text-sm text-neutral-700">I consent to Omet Omeni Ministries using these details to respond to my ministry-interest request. *</span></label><p class="field-error text-sm text-red-700" data-error-for="contactConsent"></p>
              <label class="flex items-start gap-3"><input id="newsletter" name="newsletter" type="checkbox" class="mt-1 h-4 w-4 rounded border-neutral-300 text-primary-700 focus:ring-primary-600" /><span class="text-sm text-neutral-700">I would like to receive general ministry updates.</span></label>
            </div>
            <button type="submit" class="w-full rounded-lg bg-primary-700 px-6 py-4 font-semibold text-white transition-colors hover:bg-primary-800 focus:outline-none focus:ring-2 focus:ring-primary-600 focus:ring-offset-2 disabled:cursor-not-allowed disabled:opacity-60">Submit Application</button>
            <p id="ministry-form-status" class="text-sm" role="status" aria-live="polite"></p>
          </form>
        </div>
      </div>
    </section>

    <section class="bg-gradient-to-br from-primary-700 to-secondary-700 py-20 text-white">
      <div class="mx-auto max-w-4xl px-4 text-center sm:px-6 lg:px-8">
        <h2 class="mb-4 font-display text-3xl font-bold sm:text-4xl">Discover Your Next Step</h2>
        <p class="mx-auto max-w-3xl text-xl text-white/90">Join an Omet Omeni Ministries programme or express interest in serving through Accra, Kumasi or online ministry.</p>
        <div class="mt-8 flex flex-col justify-center gap-4 sm:flex-row">
          <a href="#ministry-application" class="inline-flex items-center justify-center rounded-lg bg-white px-8 py-4 font-semibold text-primary-700 hover:bg-neutral-100 focus:outline-none focus:ring-2 focus:ring-white focus:ring-offset-2 focus:ring-offset-primary-700">Apply to Serve</a>
          <a href="/events" class="inline-flex items-center justify-center rounded-lg border-2 border-white/60 px-8 py-4 font-semibold text-white hover:bg-white/10 focus:outline-none focus:ring-2 focus:ring-white">View Ministry Events</a>
          <a href="/plan-your-visit" class="inline-flex items-center justify-center rounded-lg px-5 py-4 font-semibold text-white underline underline-offset-4 focus:outline-none focus:ring-2 focus:ring-white">Plan Your Visit</a>
        </div>
      </div>
    </section>
  </main>
  <Footer />
</Layout>

<script>
  const filterButtons = Array.from(document.querySelectorAll<HTMLButtonElement>('.filter-btn'));
  const cards = Array.from(document.querySelectorAll<HTMLElement>('.ministry-card'));
  const resultCount = document.querySelector<HTMLElement>('#filter-result-count');
  const emptyState = document.querySelector<HTMLElement>('#filter-empty-state');
  const grid = document.querySelector<HTMLElement>('#ministries-grid');

  function applyFilter(button: HTMLButtonElement) {
    const attribute = button.dataset.filterAttribute;
    const value = button.dataset.filterValue ?? '';
    filterButtons.forEach((item) => {
      const active = item === button;
      item.setAttribute('aria-pressed', String(active));
      item.classList.toggle('bg-primary-700', active);
      item.classList.toggle('text-white', active);
      item.querySelector<HTMLElement>('.filter-check')!.textContent = active ? '✓' : '';
    });
    let visible = 0;
    cards.forEach((card) => {
      const matches = attribute === 'all'
        || (attribute === 'category' && card.dataset.category === value)
        || (attribute === 'location' && card.dataset.location?.split(' ').includes(value))
        || (attribute === 'volunteer' && card.dataset.volunteerStatus === value);
      card.hidden = !matches;
      if (matches) visible += 1;
    });
    if (resultCount) resultCount.textContent = `${visible} ${visible === 1 ? 'ministry or team' : 'ministries and teams'} shown`;
    emptyState?.classList.toggle('hidden', visible !== 0);
    grid?.classList.toggle('hidden', visible === 0);
  }
  filterButtons.forEach((button) => button.addEventListener('click', () => applyFilter(button)));
  document.querySelector('#clear-filters')?.addEventListener('click', () => {
    const allButton = filterButtons.find((button) => button.dataset.filterAttribute === 'all');
    if (allButton) { applyFilter(allButton); allButton.focus(); }
  });
  const initialFilter = filterButtons.find((button) => button.dataset.filterAttribute === 'all');
  if (initialFilter) applyFilter(initialFilter);

  const interestSelect = document.querySelector<HTMLSelectElement>('#ministry-interest');
  document.querySelectorAll<HTMLAnchorElement>('[data-interest]').forEach((link) => {
    link.addEventListener('click', () => {
      const matching = Array.from(interestSelect?.options ?? []).find((option) => option.value === link.dataset.interest);
      if (matching && interestSelect) interestSelect.value = matching.value;
    });
  });

  const form = document.querySelector<HTMLFormElement>('#ministry-form');
  form?.addEventListener('submit', async (event) => {
    event.preventDefault();
    const button = form.querySelector<HTMLButtonElement>('button[type="submit"]')!;
    if (button.disabled) return;
    const status = document.querySelector<HTMLElement>('#ministry-form-status')!;
    const summary = document.querySelector<HTMLElement>('#form-errors')!;
    document.querySelectorAll<HTMLElement>('.field-error').forEach((item) => item.textContent = '');
    summary.classList.add('hidden');
    if (!form.checkValidity()) { form.reportValidity(); return; }
    button.disabled = true;
    button.textContent = 'Submitting…';
    status.className = 'text-sm text-neutral-700';
    status.textContent = 'Sending your ministry interest…';
    const formData = new FormData(form);
    const payload = Object.fromEntries(formData.entries());
    payload.availability = formData.getAll('availability').join(', ');
    try {
      const response = await fetch('/api/forms', { method: 'POST', headers: { 'Content-Type': 'application/json', Accept: 'application/json' }, body: JSON.stringify({ kind: 'ministry-interest', ...payload }) });
      const result = await response.json().catch(() => ({}));
      if (!response.ok) {
        const errors = result.errors && typeof result.errors === 'object' ? result.errors as Record<string, string> : {};
        Object.entries(errors).forEach(([field, message]) => {
          const output = document.querySelector<HTMLElement>(`[data-error-for="${field}"]`);
          if (output) output.textContent = message;
          const input = form.elements.namedItem(field);
          if (input instanceof HTMLElement) input.setAttribute('aria-invalid', 'true');
        });
        summary.textContent = result.error || 'Please review the highlighted fields.';
        summary.classList.remove('hidden');
        summary.focus();
        throw new Error('validation');
      }
      if (typeof result.reference !== 'string') throw new Error('response');
      form.reset();
      status.className = 'text-sm font-medium text-green-800';
      status.textContent = `Thank you for your interest. Your application has been received and will be reviewed. Submission does not automatically confirm placement. Reference: ${result.reference}.`;
    } catch (error) {
      if (!(error instanceof Error) || error.message !== 'validation') {
        status.className = 'text-sm font-medium text-red-800';
        status.textContent = 'We could not send your request. Your entries are still available; please try again later.';
      }
    } finally {
      button.disabled = false;
      button.textContent = 'Submit Application';
    }
  });
</script>

