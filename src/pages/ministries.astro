];

const ministryCategories = [
  { name: "All Ministries", value: "all", color: "neutral" },
  { name: "Age Groups", value: "age-groups", color: "primary" },
  { name: "Gender Specific", value: "gender-specific", color: "secondary" },
  { name: "Service", value: "service", color: "primary" },
  { name: "Spiritual", value: "spiritual", color: "secondary" }
];

const leadershipTeam = [
  {
    name: "Pastor John Doe",
    role: "Senior Pastor",
    ministry: "Overall Leadership",
    bio: "Leading Omet Omeni Ministries with passion for God's Word and heart for the community.",
    image: "primary"
  },
  {
    name: "Pastor Sarah Johnson",
    role: "Associate Pastor",
    ministry: "Women's Ministry",
    bio: "Empowering women to discover their purpose and grow in their faith journey.",
    image: "secondary"
  },
  {
    name: "Elder Michael Asante",
    role: "Youth Pastor & Elder",
    ministry: "Youth Ministry",
    bio: "Passionate about raising the next generation of Christian leaders.",
