const volunteerOpportunities = [
  {
    title: "Sunday Service Support",
    description: "Help with setup, greeting, ushering, and general service coordination",
    timeCommitment: "2-3 hours on Sundays",
    skills: "Friendly personality, punctuality",
    contact: "hello@ometomeni.org"
  },
  {
    title: "Children's Ministry Helper",
    description: "Assist with children's programs, activities, and supervision",
    timeCommitment: "2 hours on Sundays",
    skills: "Love for children, patience",
    contact: "hello@ometomeni.org"
  },
  {
    title: "Technical Support",
    description: "Audio/visual support for services and events",
    timeCommitment: "Flexible schedule",
    skills: "Basic technical knowledge",
    contact: "hello@ometomeni.org"
  },
  {
    title: "Community Outreach",
    description: "Participate in community service projects and evangelism",
    timeCommitment: "Monthly events",
    skills: "Heart for service, compassion",
    contact: "hello@ometomeni.org"
  }
];
---

<Layout 
  title="Ministries & Involvement | Omet Omeni Ministries - Find Your Place to Serve" 
  description="Discover ministry opportunities at Omet Omeni Ministries in Kumasi, Ghana. Join our youth, women's, men's, children's, worship, prayer, and outreach ministries. Find your place to serve and grow."
>
  <Header />
  
  <!-- Hero Section -->
  <section class="relative bg-gradient-to-br from-primary-50 via-white to-secondary-50 py-20">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center">
        <h1 class="text-4xl sm:text-5xl lg:text-6xl font-display font-bold text-neutral-900 mb-6">
          Ministries & <span class="text-transparent bg-clip-text bg-gradient-to-r from-primary-600 to-secondary-600">Involvement</span>
        </h1>
        <p class="text-xl text-neutral-600 max-w-3xl mx-auto mb-8">
          Discover your place to serve, grow, and make a difference. Every member has unique gifts that can impact our church and community.
        </p>
        
        <!-- Ministry Stats -->
        <div class="grid grid-cols-1 sm:grid-cols-3 gap-6 max-w-2xl mx-auto">
          <div class="bg-white p-4 rounded-lg shadow-md border border-neutral-100">
            <div class="text-2xl font-bold text-primary-600">{ministries.length}</div>
            <div class="text-neutral-600 text-sm">Active Ministries</div>
          </div>
          <div class="bg-white p-4 rounded-lg shadow-md border border-neutral-100">
            <div class="text-2xl font-bold text-secondary-600">200+</div>
            <div class="text-neutral-600 text-sm">Volunteers Serving</div>
          </div>
          <div class="bg-white p-4 rounded-lg shadow-md border border-neutral-100">
            <div class="text-2xl font-bold text-primary-600">12</div>
            <div class="text-neutral-600 text-sm">Ministry Leaders</div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Featured Ministries -->
  <section class="py-20 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-16">
        <h2 class="text-3xl sm:text-4xl font-display font-bold text-neutral-900 mb-4">
          Featured Ministries
        </h2>
        <p class="text-xl text-neutral-600">
          Explore our most active and impactful ministry opportunities
        </p>
      </div>
      
      <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
        {ministries.filter(ministry => ministry.featured).map((ministry) => (
          <div class="bg-white rounded-2xl shadow-xl overflow-hidden hover:shadow-2xl transition-shadow duration-300 border border-neutral-100">
            <div class="relative h-64">
              <img 
                src={ministry.image} 
                alt={ministry.name}
                class="w-full h-full object-cover"
              />
              <div class="absolute inset-0 bg-black/40"></div>
              <div class="absolute bottom-4 left-4 right-4">
                <div class="flex items-center justify-between">
                  <span class={`px-3 py-1 rounded-full text-sm font-medium ${
                    ministry.color === 'primary' 
                      ? 'bg-primary-600 text-white' 
                      : 'bg-secondary-600 text-white'
                  }`}>
                    {ministry.category}
                  </span>
                  <span class="bg-white/90 backdrop-blur-sm text-neutral-800 px-2 py-1 rounded-full text-sm font-medium">
                    {ministry.memberCount} members
                  </span>
                </div>
              </div>
            </div>
            
            <div class="p-8">
              <h3 class="text-2xl font-bold text-neutral-900 mb-3">{ministry.name}</h3>
              
              <div class="space-y-2 mb-4 text-sm text-neutral-600">
                <div class="flex items-center">
                  <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"></path>
                  </svg>
                  Led by {ministry.leader}
                </div>
                <div class="flex items-center">
                  <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                  </svg>
                  {ministry.meetingTime}
                </div>
                <div class="flex items-center">
                  <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z"></path>
                  </svg>
                  {ministry.ageGroup}
                </div>
              </div>
              
              <p class="text-neutral-600 mb-6 leading-relaxed">{ministry.description}</p>
              
              <div class="mb-6">
                <h4 class="font-semibold text-neutral-900 mb-3">What We Do:</h4>
                <ul class="space-y-1">
                  {ministry.activities.slice(0, 3).map((activity) => (
                    <li class="flex items-center text-sm text-neutral-600">
                      <svg class="w-3 h-3 text-primary-600 mr-2" fill="currentColor" viewBox="0 0 20 20">
                        <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"></path>
                      </svg>
                      {activity}
                    </li>
                  ))}
                </ul>
              </div>
              
              <button class={`w-full py-3 px-6 font-semibold rounded-lg transition-colors ${
                ministry.color === 'primary'
                  ? 'bg-primary-600 text-white hover:bg-primary-700'
                  : 'bg-secondary-600 text-white hover:bg-secondary-700'
              }`}>
                Learn More & Join
              </button>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- All Ministries with Filter -->
  <section class="py-20 bg-neutral-50">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-12">
        <h2 class="text-3xl sm:text-4xl font-display font-bold text-neutral-900 mb-4">
          All Ministry Opportunities
        </h2>
        <p class="text-xl text-neutral-600 mb-8">
          Find the perfect place to use your gifts and serve God's kingdom
        </p>
        
        <!-- Category Filter -->
        <div class="flex flex-wrap justify-center gap-3 mb-12">
          {ministryCategories.map((category) => (
            <button 
              class={`px-4 py-2 rounded-full text-sm font-medium transition-colors filter-btn ${
                category.color === 'primary' 
                  ? 'bg-primary-100 text-primary-700 hover:bg-primary-200' 
                  : category.color === 'secondary'
                  ? 'bg-secondary-100 text-secondary-700 hover:bg-secondary-200'
                  : 'bg-neutral-100 text-neutral-700 hover:bg-neutral-200'
              }`}
              data-category={category.value}
            >
              {category.name}
            </button>
          ))}
        </div>
      </div>
      
      <!-- Ministries Grid -->
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8" id="ministries-grid">
        {ministries.map((ministry) => (
          <div 
            class="bg-white rounded-xl shadow-lg overflow-hidden hover:shadow-xl transition-shadow duration-300 ministry-card"
            data-category={ministry.category.toLowerCase().replace(/\s+/g, '-')}
          >
            <div class="relative h-48">
              <img 
                src={ministry.image} 
                alt={ministry.name}
                class="w-full h-full object-cover"
              />
              <div class="absolute top-3 left-3">
                <span class="bg-white/90 backdrop-blur-sm text-neutral-800 px-2 py-1 rounded-full text-xs font-medium">
                  {ministry.category}
                </span>
              </div>
              <div class="absolute top-3 right-3 bg-black/60 text-white rounded px-2 py-1">
                <span class="text-xs font-medium">{ministry.memberCount}</span>
              </div>
            </div>
            
            <div class="p-6">
              <h3 class="text-lg font-semibold text-neutral-900 mb-2">{ministry.name}</h3>
              
              <div class="space-y-1 mb-3 text-sm text-neutral-600">
                <div class="flex items-center">
                  <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"></path>
                  </svg>
                  {ministry.leader}
                </div>
                <div class="flex items-center">
                  <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                  </svg>
                  {ministry.meetingTime}
                </div>
              </div>
              
              <p class="text-neutral-600 text-sm mb-4 line-clamp-3">{ministry.description}</p>
              
              <div class="flex items-center justify-between">
                <span class="text-xs text-neutral-500">{ministry.ageGroup}</span>
                <button class={`text-sm font-medium transition-colors ${
                  ministry.color === 'primary'
                    ? 'text-primary-600 hover:text-primary-700'
                    : 'text-secondary-600 hover:text-secondary-700'
                }`}>
                  Learn More →
                </button>
              </div>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Leadership Team -->
  <section class="py-20 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-16">
        <h2 class="text-3xl sm:text-4xl font-display font-bold text-neutral-900 mb-4">
          Ministry Leadership
        </h2>
        <p class="text-xl text-neutral-600">
          Meet the dedicated leaders who guide and shepherd our various ministries
        </p>
      </div>
      
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-8">
        {leadershipTeam.map((leader, index) => (
          <div class="text-center group">
            <div class={`w-24 h-24 mx-auto mb-4 rounded-2xl flex items-center justify-center ${
              leader.image === 'primary' 
                ? 'bg-gradient-to-br from-primary-500 to-primary-600' 
                : 'bg-gradient-to-br from-secondary-500 to-secondary-600'
            } group-hover:scale-110 transition-transform duration-200`}>
              <span class="text-white font-bold text-xl">{leader.name.split(' ').map(n => n[0]).join('')}</span>
            </div>
            <h3 class="text-lg font-semibold text-neutral-900 mb-1">{leader.name}</h3>
            <p class="text-primary-600 font-medium mb-2">{leader.role}</p>
            <p class="text-sm text-neutral-600 mb-3">{leader.ministry}</p>
            <p class="text-xs text-neutral-500 leading-relaxed">{leader.bio}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Volunteer Opportunities -->
  <section class="py-20 bg-gradient-to-br from-primary-50 to-secondary-50">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-16">
        <h2 class="text-3xl sm:text-4xl font-display font-bold text-neutral-900 mb-4">
          Volunteer Opportunities
        </h2>
        <p class="text-xl text-neutral-600">
          Start serving today! Here are some immediate ways you can get involved
        </p>
      </div>
      
      <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
        {volunteerOpportunities.map((opportunity, index) => (
          <div class="bg-white rounded-2xl p-8 shadow-lg hover:shadow-xl transition-shadow duration-300">
            <div class="flex items-start">
              <div class={`w-12 h-12 rounded-xl flex items-center justify-center mr-4 flex-shrink-0 ${
                index % 2 === 0 
                  ? 'bg-primary-100 text-primary-600' 
                  : 'bg-secondary-100 text-secondary-600'
              }`}>
                <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z"></path>
                </svg>
              </div>
              <div class="flex-1">
                <h3 class="text-xl font-semibold text-neutral-900 mb-3">{opportunity.title}</h3>
                <p class="text-neutral-600 mb-4">{opportunity.description}</p>
                
                <div class="space-y-2 mb-4 text-sm">
                  <div class="flex items-center text-neutral-600">
                    <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                    </svg>
                    <strong>Time:</strong> {opportunity.timeCommitment}
                  </div>
                  <div class="flex items-center text-neutral-600">
                    <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.663 17h4.673M12 3v1m6.364 1.636l-.707.707M21 12h-1M4 12H3m3.343-5.657l-.707-.707m2.828 9.9a5 5 0 117.072 0l-.548.547A3.374 3.374 0 0014 18.469V19a2 2 0 11-4 0v-.531c0-.895-.356-1.754-.988-2.386l-.548-.547z"></path>
                    </svg>
                    <strong>Skills:</strong> {opportunity.skills}
                  </div>
                </div>
                
                <a 
                  href={`mailto:${opportunity.contact}`}
                  class={`inline-flex items-center px-4 py-2 rounded-lg font-medium transition-colors ${
                    index % 2 === 0
                      ? 'bg-primary-600 text-white hover:bg-primary-700'
                      : 'bg-secondary-600 text-white hover:bg-secondary-700'
                  }`}
                >
                  Get Involved
                  <svg class="ml-2 w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"></path>
                  </svg>
                </a>
              </div>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Ministry Application -->
  <section class="py-20 bg-white">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="bg-gradient-to-br from-primary-50 to-secondary-50 rounded-2xl p-8 lg:p-12">
        <div class="text-center mb-8">
          <h2 class="text-3xl font-display font-bold text-neutral-900 mb-4">
            Ready to Get Involved?
          </h2>
          <p class="text-xl text-neutral-600">
            Fill out our ministry interest form and we'll help you find the perfect place to serve
          </p>
        </div>
        
        <form class="space-y-6" id="ministry-form">
          <div class="absolute -left-[10000px]" aria-hidden="true">
            <label for="ministry-company">Leave this field empty</label>
            <input id="ministry-company" name="company" type="text" tabindex="-1" autocomplete="off" />
          </div>
