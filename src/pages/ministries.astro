    leader: "Sister Joyce Amponsah",
    meetingTime: "Sundays before and after service",
    ageGroup: "All ages",
    activities: ["Greeting visitors", "Ushering", "Event coordination", "Refreshment service", "Facility management"],
    image: "https://images.pexels.com/photos/8468722/pexels-photo-8468722.jpeg?auto=compress&cs=tinysrgb&w=800",
