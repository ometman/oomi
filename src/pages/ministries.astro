    ageGroup: "All ages",
    activities: ["Community service", "Food distribution", "Medical outreach", "Evangelism", "Prison ministry"],
    image: "https://images.pexels.com/photos/6646918/pexels-photo-6646918.jpeg?auto=compress&cs=tinysrgb&w=800",
    featured: false,
    memberCount: "45+",
    color: "primary"
  },
