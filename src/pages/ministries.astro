<script>
  // Ministry filtering functionality
  document.addEventListener('DOMContentLoaded', function() {
    const filterButtons = document.querySelectorAll('.filter-btn');
    const ministryCards = document.querySelectorAll('.ministry-card');
    
    filterButtons.forEach(button => {
      button.addEventListener('click', function() {
        const category = this.getAttribute('data-category');
        
        // Update active button
        filterButtons.forEach(btn => {
          btn.classList.remove('bg-primary-600', 'text-white', 'bg-secondary-600', 'bg-neutral-600');
          if (btn.classList.contains('bg-primary-100')) {
            btn.classList.add('bg-primary-100', 'text-primary-700');
          } else if (btn.classList.contains('bg-secondary-100')) {
            btn.classList.add('bg-secondary-100', 'text-secondary-700');
          } else {
            btn.classList.add('bg-neutral-100', 'text-neutral-700');
          }
        });
        
        if (this.classList.contains('bg-primary-100')) {
          this.classList.remove('bg-primary-100', 'text-primary-700');
          this.classList.add('bg-primary-600', 'text-white');
        } else if (this.classList.contains('bg-secondary-100')) {
          this.classList.remove('bg-secondary-100', 'text-secondary-700');
          this.classList.add('bg-secondary-600', 'text-white');
        } else {
          this.classList.remove('bg-neutral-100', 'text-neutral-700');
          this.classList.add('bg-neutral-600', 'text-white');
        }
        
        // Filter ministries
        ministryCards.forEach(card => {
          if (category === 'all' || card.getAttribute('data-category') === category) {
            card.style.display = 'block';
            card.classList.add('animate-fade-in');
          } else {
            card.style.display = 'none';
          }
        });
      });
    });
    
    // Ministry application form handling
    const ministryForm = document.querySelector<HTMLFormElement>('#ministry-form');
    ministryForm?.addEventListener('submit', async (e) => {
      e.preventDefault();
      if (!ministryForm.checkValidity()) { ministryForm.reportValidity(); return; }
      const button = ministryForm.querySelector<HTMLButtonElement>('button[type="submit"]')!;
      const status = document.querySelector<HTMLElement>('#ministry-form-status')!;
      const originalText = button.innerHTML;
      button.disabled = true;
      button.textContent = 'Submitting…';
      status.className = 'text-sm text-neutral-600';
      status.textContent = 'Sending your ministry interest…';
      const formData = new FormData(ministryForm);
      const data = Object.fromEntries(formData.entries());
      data.availability = formData.getAll('availability').join(', ');
      try {
        const response = await fetch('/api/forms', {
          method: 'POST', headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
          body: JSON.stringify({ kind: 'ministry-interest', ...data }),
        });
        const result = await response.json().catch(() => ({}));
        if (!response.ok || typeof result.reference !== 'string') throw new Error();
        ministryForm.reset();
        status.className = 'text-sm font-medium text-green-700';
        status.textContent = `Interest sent. Your reference is ${result.reference}.`;
      } catch {
        status.className = 'text-sm font-medium text-red-700';
        status.textContent = 'We could not send your request. Your entries are still available; please try again or email hello@ometomeni.org.';
      } finally {
        button.disabled = false;
        button.innerHTML = originalText;
      }
    });
    
    // Learn more button functionality - Fixed selector
    const allButtons = document.querySelectorAll('button');
    const learnMoreButtons = Array.from(allButtons).filter(button => 
      button.textContent?.includes('Learn More')
    );
    
    learnMoreButtons.forEach(button => {
      button.addEventListener('click', function() {
        // In a real application, this would open a modal or navigate to a detailed page
        alert('Ministry details modal would open here. This would show more information about the ministry, meeting times, requirements, and contact information.');
      });
    });
  });
</script>

<style>
  .line-clamp-3 {
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  
  .animate-fade-in {
    animation: fadeIn 0.5s ease-in-out;
  }
  
  @keyframes fadeIn {
    from { opacity: 0; transform: translateY(10px); }
    to { opacity: 1; transform: translateY(0); }
  }
</style>
