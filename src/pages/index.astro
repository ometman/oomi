---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import HomeHero from '../components/home/HomeHero.astro';
import MinistryPillars from '../components/home/MinistryPillars.astro';
import VisionMission from '../components/home/VisionMission.astro';
import FeaturedSermon from '../components/home/FeaturedSermon.astro';
import UpcomingEvents from '../components/home/UpcomingEvents.astro';
import MinistryOverview from '../components/home/MinistryOverview.astro';
import LocationConnection from '../components/home/LocationConnection.astro';
import HomeNewsletter from '../components/home/HomeNewsletter.astro';
import HomeCTA from '../components/home/HomeCTA.astro';
import logo from '../assets/oomilogo.webp';
import { getUpcomingApprovedEvents } from '../data/events';
import { getLatestPublishedSermon } from '../data/sermons';

const upcomingEvents = getUpcomingApprovedEvents();
const featuredSermon = getLatestPublishedSermon();
---

<Layout
  title="Omet Omeni Ministries | Biblical Teaching, Prayer and Discipleship"
  description="Omet Omeni Ministries serves Accra, Kumasi and online through biblical teaching, prayer, worship, discipleship and kingdom-focused ministry."
  image={logo.src}
>
  <Header />
  <main>
    <HomeHero />
    <MinistryPillars />
    <VisionMission />
    <FeaturedSermon sermon={featuredSermon} />
    <UpcomingEvents events={upcomingEvents} />
    <MinistryOverview />
    <LocationConnection />
    <!-- HomeNewsletter preserves the existing NewsletterSignup component and its consent workflow. -->
    <HomeNewsletter />
    <HomeCTA />
  </main>
  <Footer />
</Layout>
