---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import GivingForm from '../components/giving/GivingForm.astro';

const onlineEnabled =
  Boolean(import.meta.env.PAYSTACK_SECRET_KEY) &&
  import.meta.env.MOBILE_MONEY_ENABLED !== 'false';
---

<Layout title="Give | Omet Omeni Ministries" description="Give securely to Omet Omeni Ministries through verified online and manual payment methods.">
  <Header />
  <main>
    <section class="relative isolate overflow-hidden bg-gradient-to-br from-primary-900 via-primary-800 to-neutral-900 py-16 text-white sm:py-20 lg:py-24">
      <div class="absolute inset-0 -z-10" aria-hidden="true">
        <div class="absolute -right-20 -top-28 h-96 w-96 rounded-full bg-secondary-400/20 blur-3xl"></div>
        <div class="absolute -bottom-44 -left-24 h-[28rem] w-[28rem] rounded-full bg-primary-400/25 blur-3xl"></div>
        <div class="absolute inset-0 bg-[radial-gradient(circle_at_top_right,rgba(255,255,255,0.12),transparent_38%)]"></div>
      </div>
      <div class="relative mx-auto grid max-w-6xl items-center gap-12 px-4 sm:px-6 lg:grid-cols-[1.2fr_0.8fr] lg:px-8">
        <div>
          <p class="text-sm font-semibold uppercase tracking-[0.2em] text-secondary-200">Give freely</p>
          <h1 class="mt-4 max-w-3xl text-4xl font-display font-bold leading-tight sm:text-5xl lg:text-6xl">Partner with the work God is doing</h1>
          <p class="mt-6 max-w-2xl text-lg leading-relaxed text-primary-100">Your voluntary gift supports ministry, discipleship, outreach, care and the responsible delivery of programmes.</p>
          <div class="mt-8 flex flex-wrap gap-4">
            <a href="#online-giving" class="inline-flex items-center justify-center rounded-lg bg-white px-6 py-3 font-semibold text-primary-900 shadow-lg shadow-black/10 transition-colors hover:bg-primary-50 focus:outline-none focus:ring-2 focus:ring-white focus:ring-offset-2 focus:ring-offset-primary-900">Give securely online</a>
            <a href="#giving-information" class="inline-flex items-center justify-center rounded-lg border border-white/30 bg-white/10 px-6 py-3 font-semibold text-white backdrop-blur-sm transition-colors hover:bg-white/15 focus:outline-none focus:ring-2 focus:ring-white">Giving information</a>
          </div>
          <p class="mt-6 flex items-center gap-2 text-sm text-primary-100">
            <svg class="h-5 w-5 flex-none text-secondary-200" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M9 12l2 2 4-4m5-3.5A11.8 11.8 0 0112 3a11.8 11.8 0 01-8 3.5V12c0 5 3.4 8 8 9 4.6-1 8-4 8-9V6.5z"></path></svg>
            Secure provider processing. We never collect your card number or Mobile Money PIN.
          </p>
        </div>
        <blockquote class="rounded-3xl border border-white/15 bg-white/10 p-7 shadow-2xl shadow-black/20 backdrop-blur-md sm:p-9">
          <svg class="h-10 w-10 text-secondary-200" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path d="M7.2 6C4.9 7.5 3.5 9.7 3 12.7V18h7v-7H6.5c.3-1.4 1.2-2.6 2.7-3.6L7.2 6zm10 0c-2.3 1.5-3.7 3.7-4.2 6.7V18h7v-7h-3.5c.3-1.4 1.2-2.6 2.7-3.6L17.2 6z"></path></svg>
          <p class="mt-5 text-xl font-medium leading-relaxed text-white">Each of you should give what you have decided in your heart to give, not reluctantly or under compulsion.</p>
          <cite class="mt-5 block text-sm font-semibold not-italic text-secondary-200">2 Corinthians 9:7</cite>
          <div class="mt-8 border-t border-white/15 pt-6">
            <p class="text-sm leading-relaxed text-primary-100">Giving is an act of worship, never a condition for prayer, care, or participation in the ministry.</p>
          </div>
        </blockquote>
      </div>
    </section>

    <section class="bg-neutral-50 py-20">
      <div class="mx-auto max-w-4xl px-4 sm:px-6 lg:px-8">
        <GivingForm enabled={onlineEnabled} />
      </div>
    </section>

    <section id="giving-information" class="bg-gradient-to-br from-primary-50 to-secondary-50 py-20">
      <div class="mx-auto grid max-w-5xl grid-cols-1 gap-8 px-4 sm:px-6 md:grid-cols-2 lg:px-8">
        <div class="rounded-2xl bg-white p-8 shadow-sm"><h2 class="text-2xl font-display font-bold text-neutral-900">Payment safety</h2><ul class="mt-5 space-y-3 text-neutral-600"><li>For Mobile Money, the backend initiates the request and you authorize it with your PIN on your phone.</li><li>The ministry website never requests a card number, CVV, expiry date or Mobile Money PIN.</li><li>Coming-soon methods do not collect payment details.</li><li>A return to this website is not treated as proof of payment; the server verifies the provider reference.</li></ul></div>
        <div class="rounded-2xl bg-white p-8 shadow-sm"><h2 class="text-2xl font-display font-bold text-neutral-900">Questions or corrections</h2><p class="mt-5 text-neutral-600">If a payment remains pending, keep the Paystack reference. For designation changes or account-detail concerns, contact the ministry before making another payment.</p><a href="/contact" class="mt-6 inline-flex font-semibold text-primary-700 underline">Contact Omet Omeni Ministries</a></div>
      </div>
    </section>
  </main>
  <Footer />
</Layout>
