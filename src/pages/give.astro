<script>
  // Giving form functionality
  document.addEventListener('DOMContentLoaded', function() {
    // Handle suggested amount buttons
    const amountButtons = document.querySelectorAll<HTMLButtonElement>('button[class*="border-primary-200"], button[class*="border-secondary-200"]');
    
    amountButtons.forEach(button => {
      button.addEventListener('click', () => {
        // Remove active state from siblings
        const siblings = button.parentElement?.querySelectorAll<HTMLButtonElement>('button') ?? [];
        siblings.forEach(sibling => {
          sibling.classList.remove('bg-primary-100', 'bg-secondary-100');
        });
        
        // Add active state to clicked button
        if (button.classList.contains('border-primary-200')) {
          button.classList.add('bg-primary-100');
        } else {
          button.classList.add('bg-secondary-100');
        }
      });
    });
    
    // Handle main giving buttons
    const giveButtons = document.querySelectorAll('button[class*="bg-primary-600"], button[class*="bg-secondary-600"]');
    
    giveButtons.forEach(button => {
      button.addEventListener('click', function() {
        // In a real application, this would open a payment modal or redirect to payment processor
        alert('Thank you for your heart to give! Payment processing will be implemented with a secure payment gateway.');
      });
    });
    
    // Handle main "Give Now" button
    const mainGiveButton = document.getElementById('give-now-btn');
    mainGiveButton?.addEventListener('click', function() {
      // Scroll to giving options
      const givingSection = document.querySelector('section:has(.grid .bg-white.rounded-2xl)');
      givingSection?.scrollIntoView({ behavior: 'smooth' });
    });
  });
</script>
