---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

// Sample giving options and impact data
const givingOptions = [
  {
    id: 'tithe',
    title: 'Tithes & Offerings',
    description: 'Support the general ministry and operations of Omet Omeni Ministries',
    icon: 'heart',
    suggested: [50, 100, 200, 500],
    color: 'primary'
  },
  {
    id: 'missions',
    title: 'Missions & Outreach',
    description: 'Help us reach communities in Kumasi and beyond with the Gospel',
    icon: 'globe',
    suggested: [25, 75, 150, 300],
    color: 'secondary'
  },
  {
    id: 'youth',
    title: 'Youth Ministry',
    description: 'Invest in the next generation through youth programs and activities',
    icon: 'users',
    suggested: [30, 60, 120, 250],
    color: 'primary'
  },
  {
    id: 'building',
    title: 'Building Fund',
    description: 'Help us secure a permanent home for our growing congregation',
    icon: 'building',
    suggested: [100, 250, 500, 1000],
    color: 'secondary'
  },
  {
    id: 'benevolence',
    title: 'Benevolence Fund',
    description: 'Support families and individuals in need within our community',
    icon: 'gift',
    suggested: [20, 50, 100, 200],
    color: 'primary'
  },
  {
    id: 'special',
    title: 'Special Projects',
    description: 'Contribute to specific events, equipment, and ministry initiatives',
    icon: 'star',
    suggested: [40, 80, 160, 400],
    color: 'secondary'
  }
];

const impactStats = [
  {
    number: '150+',
    label: 'Families Supported',
    description: 'Through our benevolence and outreach programs'
  },
  {
    number: '50+',
    label: 'Youth Engaged',
    description: 'In our weekly youth ministry programs'
  },
  {
    number: '12',
    label: 'Community Outreaches',
    description: 'Organized this year to serve our neighbors'
  },
  {
    number: '300+',
    label: 'Lives Touched',
    description: 'Through our various ministry initiatives'
  }
];

const paymentMethods = [
  {
    name: 'Mobile Money',
    description: 'MTN, Vodafone, AirtelTigo',
    icon: 'phone',
    details: 'Send to: 0XX-XXX-XXXX (Omet Omeni Ministries)'
  },
  {
    name: 'Bank Transfer',
    description: 'Direct bank deposit',
    icon: 'bank',
    details: 'Account: XXXX-XXXX-XXXX (GCB Bank)'
  },
  {
    name: 'Cash/Cheque',
    description: 'During service or office hours',
    icon: 'cash',
    details: 'Give during service or visit our office'
  },
  {
    name: 'Online Giving',
    description: 'Secure online donations',
    icon: 'credit-card',
    details: 'Coming soon - secure online platform'
  }
];
---

<Layout 
  title="Give & Support | Omet Omeni Ministries - Make a Difference" 
  description="Support Omet Omeni Ministries's mission through tithes, offerings, and donations. Your generosity helps us serve our community, support missions, and build God's kingdom in Kumasi, Ghana."
>
  <Header />
  
  <!-- Hero Section -->
  <section class="relative bg-gradient-to-br from-primary-50 via-white to-secondary-50 py-20">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center">
        <h1 class="text-4xl sm:text-5xl lg:text-6xl font-display font-bold text-neutral-900 mb-6">
          Give & <span class="text-transparent bg-clip-text bg-gradient-to-r from-primary-600 to-secondary-600">Support</span>
        </h1>
        <p class="text-xl text-neutral-600 max-w-3xl mx-auto mb-8">
          Your generosity enables us to serve our community, support missions, and build God's kingdom. Every gift, no matter the size, makes a difference.
        </p>
        
        <!-- Bible Verse -->
        <div class="bg-white p-6 rounded-xl shadow-lg border border-neutral-100 max-w-2xl mx-auto">
          <blockquote class="text-lg text-neutral-700 italic mb-3">
            "Each of you should give what you have decided in your heart to give, not reluctantly or under compulsion, for God loves a cheerful giver."
          </blockquote>
          <cite class="text-primary-600 font-medium">2 Corinthians 9:7</cite>
        </div>
      </div>
    </div>
  </section>

  <!-- Impact Section -->
  <section class="py-20 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-16">
        <h2 class="text-3xl sm:text-4xl font-display font-bold text-neutral-900 mb-4">
          Your Impact in Action
        </h2>
        <p class="text-xl text-neutral-600 max-w-3xl mx-auto">
          See how your generous giving is transforming lives and building God's kingdom in our community.
        </p>
      </div>
      
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-8">
        {impactStats.map((stat, index) => (
          <div class="text-center group">
            <div class={`w-20 h-20 mx-auto mb-6 rounded-2xl flex items-center justify-center ${
              index % 2 === 0 
                ? 'bg-gradient-to-br from-primary-500 to-primary-600 group-hover:from-primary-600 group-hover:to-primary-700' 
                : 'bg-gradient-to-br from-secondary-500 to-secondary-600 group-hover:from-secondary-600 group-hover:to-secondary-700'
            } transition-all duration-300 group-hover:scale-110`}>
              <span class="text-2xl font-bold text-white">{stat.number}</span>
            </div>
            <h3 class="text-xl font-semibold text-neutral-900 mb-2">{stat.label}</h3>
            <p class="text-neutral-600 text-sm">{stat.description}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Giving Options -->
  <section class="py-20 bg-neutral-50">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-16">
        <h2 class="text-3xl sm:text-4xl font-display font-bold text-neutral-900 mb-4">
          Ways to Give
        </h2>
        <p class="text-xl text-neutral-600 max-w-3xl mx-auto">
          Choose how you'd like to support our ministry. Every contribution helps us serve God and our community better.
        </p>
      </div>
      
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
        {givingOptions.map((option) => (
          <div class="bg-white rounded-2xl shadow-lg overflow-hidden hover:shadow-xl transition-shadow duration-300 border border-neutral-100">
            <div class={`h-2 ${option.color === 'primary' ? 'bg-gradient-to-r from-primary-500 to-primary-600' : 'bg-gradient-to-r from-secondary-500 to-secondary-600'}`}></div>
            
            <div class="p-8">
              <div class="flex items-center mb-6">
                <div class={`w-12 h-12 rounded-xl flex items-center justify-center mr-4 ${
                  option.color === 'primary' 
                    ? 'bg-primary-100 text-primary-600' 
                    : 'bg-secondary-100 text-secondary-600'
                }`}>
                  {option.icon === 'heart' && (
                    <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z"></path>
                    </svg>
                  )}
                  {option.icon === 'globe' && (
                    <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3.055 11H5a2 2 0 012 2v1a2 2 0 002 2 2 2 0 012 2v2.945M8 3.935V5.5A2.5 2.5 0 0010.5 8h.5a2 2 0 012 2 2 2 0 104 0 2 2 0 012-2h1.064M15 20.488V18a2 2 0 012-2h3.064M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                    </svg>
                  )}
                  {option.icon === 'users' && (
                    <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z"></path>
                    </svg>
                  )}
                  {option.icon === 'building' && (
                    <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4"></path>
                    </svg>
                  )}
                  {option.icon === 'gift' && (
                    <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v13m0-13V6a2 2 0 112 2h-2zm0 0V5.5A2.5 2.5 0 109.5 8H12zm-7 4h14M5 12a2 2 0 110-4h14a2 2 0 110 4M5 12v7a2 2 0 002 2h10a2 2 0 002-2v-7"></path>
                    </svg>
                  )}
                  {option.icon === 'star' && (
                    <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11.049 2.927c.3-.921 1.603-.921 1.902 0l1.519 4.674a1 1 0 00.95.69h4.915c.969 0 1.371 1.24.588 1.81l-3.976 2.888a1 1 0 00-.363 1.118l1.518 4.674c.3.922-.755 1.688-1.538 1.118l-3.976-2.888a1 1 0 00-1.176 0l-3.976 2.888c-.783.57-1.838-.197-1.538-1.118l1.518-4.674a1 1 0 00-.363-1.118l-3.976-2.888c-.784-.57-.38-1.81.588-1.81h4.914a1 1 0 00.951-.69l1.519-4.674z"></path>
                    </svg>
                  )}
                </div>
                <h3 class="text-xl font-semibold text-neutral-900">{option.title}</h3>
              </div>
              
              <p class="text-neutral-600 mb-6 leading-relaxed">{option.description}</p>
              
              <!-- Suggested Amounts -->
              <div class="mb-6">
                <p class="text-sm font-medium text-neutral-700 mb-3">Suggested amounts (GHS):</p>
                <div class="grid grid-cols-2 gap-2">
                  {option.suggested.map((amount) => (
                    <button class={`px-3 py-2 text-sm font-medium rounded-lg border transition-colors ${
                      option.color === 'primary'
                        ? 'border-primary-200 text-primary-700 hover:bg-primary-50'
                        : 'border-secondary-200 text-secondary-700 hover:bg-secondary-50'
                    }`}>
                      GHS {amount}
                    </button>
                  ))}
                </div>
              </div>
              
              <button class={`w-full py-3 px-6 font-semibold rounded-lg transition-colors ${
                option.color === 'primary'
                  ? 'bg-primary-600 text-white hover:bg-primary-700'
                  : 'bg-secondary-600 text-white hover:bg-secondary-700'
              }`}>
                Give Now
              </button>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Payment Methods -->
  <section class="py-20 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-16">
        <h2 class="text-3xl sm:text-4xl font-display font-bold text-neutral-900 mb-4">
          How to Give
        </h2>
        <p class="text-xl text-neutral-600 max-w-3xl mx-auto">
          We've made it easy for you to give through various convenient methods. Choose what works best for you.
        </p>
      </div>
      
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-8">
        {paymentMethods.map((method, index) => (
          <div class="bg-gradient-to-br from-neutral-50 to-white p-6 rounded-2xl border border-neutral-100 hover:shadow-lg transition-shadow duration-300">
            <div class="text-center">
              <div class={`w-16 h-16 mx-auto mb-4 rounded-2xl flex items-center justify-center ${
                index % 2 === 0 
                  ? 'bg-gradient-to-br from-primary-500 to-primary-600' 
                  : 'bg-gradient-to-br from-secondary-500 to-secondary-600'
              }`}>
                {method.icon === 'phone' && (
                  <svg class="w-8 h-8 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 18h.01M8 21h8a2 2 0 002-2V5a2 2 0 00-2-2H8a2 2 0 00-2 2v14a2 2 0 002 2z"></path>
                  </svg>
                )}
                {method.icon === 'bank' && (
                  <svg class="w-8 h-8 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 14v3m4-3v3m4-3v3M3 21h18M3 10h18M10.5 3L12 2l1.5 1H21l-1 6H4l-1-6h7.5z"></path>
                  </svg>
                )}
                {method.icon === 'cash' && (
                  <svg class="w-8 h-8 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 9V7a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2m2 4h10a2 2 0 002-2v-6a2 2 0 00-2-2H9a2 2 0 00-2 2v6a2 2 0 002 2zm7-5a2 2 0 11-4 0 2 2 0 014 0z"></path>
                  </svg>
                )}
                {method.icon === 'credit-card' && (
                  <svg class="w-8 h-8 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 10h18M7 15h1m4 0h1m-7 4h12a3 3 0 003-3V8a3 3 0 00-3-3H6a3 3 0 00-3 3v8a3 3 0 003 3z"></path>
                  </svg>
                )}
              </div>
              
              <h3 class="text-lg font-semibold text-neutral-900 mb-2">{method.name}</h3>
              <p class="text-neutral-600 text-sm mb-3">{method.description}</p>
              <p class="text-xs text-neutral-500 bg-neutral-100 p-2 rounded-lg">{method.details}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Recurring Giving -->
  <section class="py-20 bg-gradient-to-br from-primary-50 to-secondary-50">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="bg-white rounded-2xl shadow-xl p-8 lg:p-12">
        <div class="text-center mb-8">
          <div class="w-16 h-16 bg-gradient-to-br from-primary-500 to-secondary-500 rounded-2xl flex items-center justify-center mx-auto mb-6">
            <svg class="w-8 h-8 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"></path>
            </svg>
          </div>
          <h2 class="text-3xl font-display font-bold text-neutral-900 mb-4">
            Set Up Recurring Giving
          </h2>
          <p class="text-xl text-neutral-600">
            Make giving a regular part of your worship with automated recurring donations.
          </p>
        </div>
        
        <div class="grid grid-cols-1 md:grid-cols-2 gap-8 items-center">
          <div>
            <h3 class="text-xl font-semibold text-neutral-900 mb-4">Benefits of Recurring Giving:</h3>
            <ul class="space-y-3">
              <li class="flex items-start">
                <svg class="w-5 h-5 text-primary-600 mr-3 mt-0.5" fill="currentColor" viewBox="0 0 20 20">
                  <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"></path>
                </svg>
                <span class="text-neutral-600">Consistent support for ministry</span>
              </li>
              <li class="flex items-start">
                <svg class="w-5 h-5 text-primary-600 mr-3 mt-0.5" fill="currentColor" viewBox="0 0 20 20">
                  <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"></path>
                </svg>
                <span class="text-neutral-600">Never forget to give</span>
              </li>
              <li class="flex items-start">
                <svg class="w-5 h-5 text-primary-600 mr-3 mt-0.5" fill="currentColor" viewBox="0 0 20 20">
                  <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"></path>
                </svg>
                <span class="text-neutral-600">Easy to manage and modify</span>
              </li>
              <li class="flex items-start">
                <svg class="w-5 h-5 text-primary-600 mr-3 mt-0.5" fill="currentColor" viewBox="0 0 20 20">
                  <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"></path>
                </svg>
                <span class="text-neutral-600">Helps with church planning</span>
              </li>
            </ul>
          </div>
          
          <div class="bg-neutral-50 p-6 rounded-xl">
            <h4 class="text-lg font-semibold text-neutral-900 mb-4">Get Started Today</h4>
            <p class="text-neutral-600 mb-6">
              Contact our office to set up recurring giving through your preferred method.
            </p>
            <div class="space-y-3">
              <a 
                href="/contact" 
                class="block w-full bg-primary-600 text-white text-center font-semibold py-3 px-6 rounded-lg hover:bg-primary-700 transition-colors"
              >
                Contact Us
              </a>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Transparency Section -->
  <section class="py-20 bg-white">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-12">
        <h2 class="text-3xl sm:text-4xl font-display font-bold text-neutral-900 mb-4">
          Financial Transparency
        </h2>
        <p class="text-xl text-neutral-600">
          We believe in being good stewards of your generous gifts and maintaining full transparency.
        </p>
      </div>
      
      <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
        <div class="bg-gradient-to-br from-primary-50 to-primary-100 p-8 rounded-2xl">
          <div class="flex items-center mb-4">
            <div class="w-12 h-12 bg-primary-600 rounded-xl flex items-center justify-center mr-4">
              <svg class="w-6 h-6 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"></path>
              </svg>
            </div>
            <h3 class="text-xl font-semibold text-neutral-900">Annual Reports</h3>
          </div>
          <p class="text-neutral-600 mb-4">
            We publish annual financial reports showing how donations are used across our various ministries and operations.
          </p>
          <a href="#" class="text-primary-600 font-medium hover:text-primary-700">
            View Latest Report →
          </a>
        </div>
        
        <div class="bg-gradient-to-br from-secondary-50 to-secondary-100 p-8 rounded-2xl">
          <div class="flex items-center mb-4">
            <div class="w-12 h-12 bg-secondary-600 rounded-xl flex items-center justify-center mr-4">
              <svg class="w-6 h-6 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"></path>
              </svg>
            </div>
            <h3 class="text-xl font-semibold text-neutral-900">Secure Giving</h3>
          </div>
          <p class="text-neutral-600 mb-4">
            All online donations are processed through secure, encrypted systems to protect your personal and financial information.
          </p>
          <a href="#" class="text-secondary-600 font-medium hover:text-secondary-700">
            Security Information →
          </a>
        </div>
      </div>
      
      <!-- Fund Allocation -->
      <div class="mt-12 bg-neutral-50 p-8 rounded-2xl">
        <h3 class="text-2xl font-semibold text-neutral-900 mb-6 text-center">How Your Donations Are Used</h3>
        <div class="grid grid-cols-1 md:grid-cols-4 gap-6">
          <div class="text-center">
            <div class="w-16 h-16 bg-primary-600 rounded-full flex items-center justify-center mx-auto mb-3">
              <span class="text-white font-bold text-lg">60%</span>
            </div>
            <h4 class="font-semibold text-neutral-900 mb-1">Ministry & Operations</h4>
            <p class="text-sm text-neutral-600">Staff, utilities, programs</p>
          </div>
          <div class="text-center">
            <div class="w-16 h-16 bg-secondary-600 rounded-full flex items-center justify-center mx-auto mb-3">
              <span class="text-white font-bold text-lg">20%</span>
            </div>
            <h4 class="font-semibold text-neutral-900 mb-1">Missions & Outreach</h4>
            <p class="text-sm text-neutral-600">Community service, evangelism</p>
          </div>
          <div class="text-center">
            <div class="w-16 h-16 bg-primary-600 rounded-full flex items-center justify-center mx-auto mb-3">
              <span class="text-white font-bold text-lg">15%</span>
            </div>
            <h4 class="font-semibold text-neutral-900 mb-1">Building & Facilities</h4>
            <p class="text-sm text-neutral-600">Maintenance, improvements</p>
          </div>
          <div class="text-center">
            <div class="w-16 h-16 bg-secondary-600 rounded-full flex items-center justify-center mx-auto mb-3">
              <span class="text-white font-bold text-lg">5%</span>
            </div>
            <h4 class="font-semibold text-neutral-900 mb-1">Administration</h4>
            <p class="text-sm text-neutral-600">Financial management</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Testimonials -->
  <section class="py-20 bg-gradient-to-br from-neutral-50 to-white">
