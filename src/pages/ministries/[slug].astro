---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import { categoryLabels, locationLabels, ministries, statusLabels } from '../../data/ministries';
import { featuredProgrammes, recurringProgrammes } from '../../data/events';
import { getPublishedSermons } from '../../data/sermons';
import { volunteerOpportunities } from '../../data/volunteerOpportunities';

export function getStaticPaths() {
  return ministries.map((ministry) => ({ params: { slug: ministry.slug }, props: { ministry } }));
}

const { ministry } = Astro.props;
const relatedEvents = [...recurringProgrammes, ...featuredProgrammes].filter((event) => ministry.relatedEventSlugs.includes(event.id));
const relatedSermons = getPublishedSermons().filter((sermon) => ministry.relatedSermonSlugs.includes(sermon.id));
const relatedRoles = volunteerOpportunities.filter((role) =>
  ministry.slug.includes('prayer') ? role.slug === 'prayer-support'
  : ministry.slug.includes('outreach') ? role.slug === 'outreach-support'
  : ministry.slug.includes('digital') || ministry.slug.includes('media') ? ['media-and-technical-support', 'communications-and-content'].includes(role.slug)
  : false
);
---

<Layout title={`${ministry.title} | Omet Omeni Ministries`} description={ministry.description} image={ministry.image}>
  <Header />
  <main>
    <section class="relative min-h-[30rem] overflow-hidden bg-neutral-900">
      <img src={ministry.image} alt="" width="1600" height="900" class="absolute inset-0 h-full w-full object-cover opacity-45" />
      <div class="relative mx-auto flex min-h-[30rem] max-w-7xl items-end px-4 py-16 sm:px-6 lg:px-8">
        <div class="max-w-3xl text-white">
          <a href="/ministries" class="font-semibold text-secondary-200 underline underline-offset-4 focus:outline-none focus:ring-2 focus:ring-white">← All ministries</a>
          <p class="mt-8 text-sm font-semibold uppercase tracking-[0.2em] text-secondary-200">{categoryLabels[ministry.category]}</p>
          <h1 class="mt-3 font-display text-4xl font-bold sm:text-6xl">{ministry.title}</h1>
          <p class="mt-5 text-xl leading-relaxed text-white/90">{ministry.description}</p>
        </div>
      </div>
    </section>

    <section class="bg-white py-20">
      <div class="mx-auto grid max-w-7xl gap-10 px-4 sm:px-6 lg:grid-cols-[2fr_1fr] lg:px-8">
        <div>
          <h2 class="font-display text-3xl font-bold text-neutral-900">Ministry purpose</h2>
          <p class="mt-5 text-lg leading-relaxed text-neutral-600">{ministry.fullDescription}</p>
          <h2 class="mt-12 font-display text-3xl font-bold text-neutral-900">Main activities</h2>
          <ul class="mt-6 grid gap-3 sm:grid-cols-2">
            {ministry.activities.map((activity) => <li class="flex rounded-xl border border-neutral-200 bg-neutral-50 p-4 text-neutral-700"><span class="mr-3 font-bold text-primary-700" aria-hidden="true">✓</span>{activity}</li>)}
          </ul>
        </div>
        <aside class="h-fit rounded-2xl border border-neutral-200 bg-gradient-to-br from-primary-50 to-secondary-50 p-7 shadow-lg" aria-label="Ministry details">
          <span class="rounded-full bg-primary-700 px-3 py-1 text-sm font-semibold text-white">{statusLabels[ministry.status]}</span>
          <dl class="mt-6 space-y-5">
            <div><dt class="text-sm font-semibold uppercase tracking-wide text-neutral-500">Focus</dt><dd class="mt-1 text-neutral-900">{ministry.focus}</dd></div>
            <div><dt class="text-sm font-semibold uppercase tracking-wide text-neutral-500">Locations</dt><dd class="mt-1 text-neutral-900">{ministry.locations.map((location) => locationLabels[location]).join(', ')}</dd></div>
            <div><dt class="text-sm font-semibold uppercase tracking-wide text-neutral-500">Format</dt><dd class="mt-1 text-neutral-900">{ministry.format}</dd></div>
            <div><dt class="text-sm font-semibold uppercase tracking-wide text-neutral-500">Participation</dt><dd class="mt-1 text-neutral-900">{ministry.participationLabel}</dd></div>
          </dl>
          {ministry.safeguardingRequired && <p class="mt-6 rounded-lg bg-white p-4 text-sm text-neutral-700">Service in this area requires approval, appropriate training and safeguarding processes.</p>}
          <a href={`/ministries?interest=${ministry.slug}#ministry-application`} class="mt-7 block rounded-lg bg-primary-700 px-5 py-3 text-center font-semibold text-white hover:bg-primary-800 focus:outline-none focus:ring-2 focus:ring-primary-600 focus:ring-offset-2">{ministry.acceptingVolunteers ? 'Apply to Serve' : 'Express Interest'}</a>
        </aside>
      </div>
    </section>

    {(relatedEvents.length > 0 || relatedSermons.length > 0) && (
      <section class="bg-neutral-50 py-20">
        <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
          <h2 class="font-display text-3xl font-bold text-neutral-900">Related programmes and teaching</h2>
          <div class="mt-8 grid gap-6 md:grid-cols-2 lg:grid-cols-3">
            {relatedEvents.map((event) => <article class="rounded-2xl border border-neutral-200 bg-white p-6 shadow-sm"><p class="text-sm font-semibold uppercase tracking-wide text-primary-700">Programme</p><h3 class="mt-2 text-xl font-bold text-neutral-900">{event.title}</h3><p class="mt-3 text-neutral-600">{event.description}</p><a href="/events" class="mt-5 inline-flex font-semibold text-primary-700 underline decoration-secondary-500 underline-offset-4">View programmes →</a></article>)}
            {relatedSermons.map((sermon) => <article class="rounded-2xl border border-neutral-200 bg-white p-6 shadow-sm"><p class="text-sm font-semibold uppercase tracking-wide text-primary-700">Teaching</p><h3 class="mt-2 text-xl font-bold text-neutral-900">{sermon.title}</h3><p class="mt-3 text-neutral-600">{sermon.excerpt}</p><a href="/sermons" class="mt-5 inline-flex font-semibold text-primary-700 underline decoration-secondary-500 underline-offset-4">Explore teaching →</a></article>)}
          </div>
        </div>
      </section>
    )}

    <section class="bg-white py-20">
      <div class="mx-auto max-w-5xl px-4 text-center sm:px-6 lg:px-8">
        <h2 class="font-display text-3xl font-bold text-neutral-900">Take a responsible next step</h2>
        <p class="mx-auto mt-4 max-w-2xl text-lg text-neutral-600">{relatedRoles.length ? 'Related service opportunities are available for expressions of interest. Placement follows review, training and ministry approval where required.' : 'Explore confirmed programmes, express interest, or plan a visit. We will confirm appropriate next steps.'}</p>
        {relatedRoles.length > 0 && <p class="mt-4 font-semibold text-primary-800">{relatedRoles.map((role) => role.title).join(' · ')}</p>}
        <div class="mt-8 flex flex-col justify-center gap-4 sm:flex-row">
          <a href={`/ministries?interest=${ministry.slug}#ministry-application`} class="rounded-lg bg-primary-700 px-7 py-3 font-semibold text-white hover:bg-primary-800">Apply to Serve</a>
          <a href="/events" class="rounded-lg border border-primary-700 px-7 py-3 font-semibold text-primary-800 hover:bg-primary-50">View Ministry Events</a>
          <a href="/plan-your-visit" class="px-7 py-3 font-semibold text-primary-800 underline underline-offset-4">Plan Your Visit</a>
        </div>
      </div>
    </section>
  </main>
  <Footer />
</Layout>
