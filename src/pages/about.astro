---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
---

<Layout 
  title="About Us | Omet Omeni Ministries - Preaching and Teaching Jesus Christ" 
  description="Learn about Omet Omeni Ministries' mission, beliefs, history, and leadership. We are a vibrant Christian community in Kumasi, Ghana, dedicated to faith, fellowship, and spiritual growth."
>
  <Header />
  
  <!-- Hero Section -->
  <section class="relative bg-gradient-to-br from-primary-50 via-white to-secondary-50 py-20">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center">
        <h1 class="text-4xl sm:text-5xl lg:text-6xl font-display font-bold text-neutral-900 mb-6">
          About <span class="text-transparent bg-clip-text bg-gradient-to-r from-primary-600 to-secondary-600">Omet Omeni Ministries</span>
        </h1>
        <p class="text-xl text-neutral-600 max-w-3xl mx-auto">
          A vibrant Christian community where faith meets fellowship, dedicated to spreading God's love and building disciples in Kumasi, Ghana.
        </p>
      </div>
    </div>
  </section>

  <!-- Mission & Vision -->
  <section class="py-20 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-16 items-center">
        <div class="space-y-8">
          <div>
            <h2 class="text-3xl sm:text-4xl font-display font-bold text-neutral-900 mb-6">Our Mission</h2>
            <p class="text-lg text-neutral-600 leading-relaxed mb-6">
              To create a welcoming community where people can encounter God's love, grow in their faith, and discover their purpose in Christ. As a branch of Christian Life Centre, we are committed to:
            </p>
            <ul class="space-y-3 text-neutral-600">
              <li class="flex items-start space-x-3">
                <svg class="w-5 h-5 text-primary-600 mt-0.5" fill="currentColor" viewBox="0 0 20 20">
                  <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"></path>
                </svg>
                <span>Proclaiming the Gospel of Jesus Christ</span>
              </li>
              <li class="flex items-start space-x-3">
                <svg class="w-5 h-5 text-primary-600 mt-0.5" fill="currentColor" viewBox="0 0 20 20">
                  <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"></path>
                </svg>
                <span>Building authentic Christian community</span>
              </li>
              <li class="flex items-start space-x-3">
                <svg class="w-5 h-5 text-primary-600 mt-0.5" fill="currentColor" viewBox="0 0 20 20">
                  <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"></path>
                </svg>
                <span>Equipping believers for service and ministry</span>
              </li>
              <li class="flex items-start space-x-3">
                <svg class="w-5 h-5 text-primary-600 mt-0.5" fill="currentColor" viewBox="0 0 20 20">
                  <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"></path>
                </svg>
                <span>Reaching out to transform communities</span>
              </li>
            </ul>
          </div>
        </div>
        
        <div class="relative">
          <img 
            src="https://images.pexels.com/photos/8468722/pexels-photo-8468722.jpeg?auto=compress&cs=tinysrgb&w=800" 
            alt="Church community gathering"
            class="w-full h-80 object-cover rounded-2xl shadow-2xl"
          />
          <div class="absolute -bottom-6 -right-6 w-32 h-32 bg-gradient-to-br from-primary-500 to-secondary-500 rounded-2xl opacity-20"></div>
        </div>
      </div>
    </div>
  </section>

  <!-- Vision Section -->
  <section class="py-20 bg-neutral-50">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-16 items-center">
        <div class="relative order-2 lg:order-1">
          <img 
            src="https://images.pexels.com/photos/5206040/pexels-photo-5206040.jpeg?auto=compress&cs=tinysrgb&w=800" 
            alt="People in prayer and worship"
            class="w-full h-80 object-cover rounded-2xl shadow-2xl"
          />
          <div class="absolute -top-6 -left-6 w-32 h-32 bg-gradient-to-br from-secondary-500 to-primary-500 rounded-2xl opacity-20"></div>
        </div>
        
        <div class="space-y-8 order-1 lg:order-2">
          <div>
            <h2 class="text-3xl sm:text-4xl font-display font-bold text-neutral-900 mb-6">Our Vision</h2>
            <p class="text-lg text-neutral-600 leading-relaxed mb-6">
              To be a thriving church community that demonstrates God's love through our actions, transforms lives through the power of the Gospel, and impacts Kumasi and beyond with the hope of Jesus Christ.
            </p>
            <div class="bg-white p-6 rounded-xl shadow-lg">
              <h3 class="text-xl font-semibold text-neutral-900 mb-4">We Envision:</h3>
              <ul class="space-y-3 text-neutral-600">
                <li class="flex items-start space-x-3">
                  <svg class="w-5 h-5 text-secondary-600 mt-0.5" fill="currentColor" viewBox="0 0 20 20">
                    <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"></path>
                  </svg>
                  <span>A community where everyone feels loved and accepted</span>
                </li>
                <li class="flex items-start space-x-3">
                  <svg class="w-5 h-5 text-secondary-600 mt-0.5" fill="currentColor" viewBox="0 0 20 20">
                    <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"></path>
                  </svg>
                  <span>Believers equipped to make a difference in their spheres</span>
                </li>
                <li class="flex items-start space-x-3">
                  <svg class="w-5 h-5 text-secondary-600 mt-0.5" fill="currentColor" viewBox="0 0 20 20">
                    <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"></path>
                  </svg>
                  <span>Multiple churches planted across Ghana and Africa</span>
                </li>
              </ul>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Core Beliefs -->
  <section class="py-20 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-16">
        <h2 class="text-3xl sm:text-4xl font-display font-bold text-neutral-900 mb-4">
          What We Believe
        </h2>
        <p class="text-xl text-neutral-600 max-w-3xl mx-auto">
          Our faith is grounded in biblical truth and centered on Jesus Christ as Lord and Savior.
        </p>
      </div>
      
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
        <!-- Belief 1 -->
        <div class="bg-gradient-to-br from-primary-50 to-primary-100 p-8 rounded-2xl">
          <div class="w-12 h-12 bg-primary-600 rounded-xl flex items-center justify-center mb-6">
            <svg class="w-6 h-6 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.746 0 3.332.477 4.5 1.253v13C19.832 18.477 18.246 18 16.5 18c-1.746 0-3.332.477-4.5 1.253"></path>
            </svg>
          </div>
          <h3 class="text-xl font-semibold text-neutral-900 mb-3">Scripture</h3>
          <p class="text-neutral-600">
            We believe the Bible is the inspired, infallible Word of God and our ultimate authority for faith and life.
          </p>
        </div>

        <!-- Belief 2 -->
        <div class="bg-gradient-to-br from-secondary-50 to-secondary-100 p-8 rounded-2xl">
          <div class="w-12 h-12 bg-secondary-600 rounded-xl flex items-center justify-center mb-6">
            <svg class="w-6 h-6 text-white" fill="currentColor" viewBox="0 0 24 24">
              <path d="M12 2L2 7v10c0 5.55 3.84 9.74 9 11 5.16-1.26 9-5.45 9-11V7l-10-5z"/>
            </svg>
          </div>
          <h3 class="text-xl font-semibold text-neutral-900 mb-3">Trinity</h3>
          <p class="text-neutral-600">
            We believe in one God eternally existing in three persons: Father, Son, and Holy Spirit.
          </p>
        </div>

        <!-- Belief 3 -->
        <div class="bg-gradient-to-br from-primary-50 to-secondary-50 p-8 rounded-2xl">
          <div class="w-12 h-12 bg-gradient-to-br from-primary-600 to-secondary-600 rounded-xl flex items-center justify-center mb-6">
            <svg class="w-6 h-6 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z"></path>
            </svg>
          </div>
          <h3 class="text-xl font-semibold text-neutral-900 mb-3">Salvation</h3>
          <p class="text-neutral-600">
            We believe salvation is by grace through faith in Jesus Christ alone, not by works.
          </p>
        </div>

        <!-- Belief 4 -->
        <div class="bg-gradient-to-br from-secondary-50 to-secondary-100 p-8 rounded-2xl">
          <div class="w-12 h-12 bg-secondary-600 rounded-xl flex items-center justify-center mb-6">
            <svg class="w-6 h-6 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z"></path>
            </svg>
          </div>
          <h3 class="text-xl font-semibold text-neutral-900 mb-3">Church</h3>
          <p class="text-neutral-600">
            We believe the church is the body of Christ, called to worship, fellowship, and serve together.
          </p>
        </div>

        <!-- Belief 5 -->
        <div class="bg-gradient-to-br from-primary-50 to-primary-100 p-8 rounded-2xl">
          <div class="w-12 h-12 bg-primary-600 rounded-xl flex items-center justify-center mb-6">
            <svg class="w-6 h-6 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3.055 11H5a2 2 0 012 2v1a2 2 0 002 2 2 2 0 012 2v2.945M8 3.935V5.5A2.5 2.5 0 0010.5 8h.5a2 2 0 012 2 2 2 0 104 0 2 2 0 012-2h1.064M15 20.488V18a2 2 0 012-2h3.064M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
            </svg>
          </div>
          <h3 class="text-xl font-semibold text-neutral-900 mb-3">Great Commission</h3>
          <p class="text-neutral-600">
            We believe in sharing the Gospel and making disciples of all nations as commanded by Jesus.
          </p>
        </div>

        <!-- Belief 6 -->
        <div class="bg-gradient-to-br from-secondary-50 to-primary-50 p-8 rounded-2xl">
          <div class="w-12 h-12 bg-gradient-to-br from-secondary-600 to-primary-600 rounded-xl flex items-center justify-center mb-6">
            <svg class="w-6 h-6 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"></path>
            </svg>
          </div>
          <h3 class="text-xl font-semibold text-neutral-900 mb-3">Holy Spirit</h3>
          <p class="text-neutral-600">
            We believe in the gifts and power of the Holy Spirit working in believers today.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Leadership Section -->
  <section class="py-20 bg-neutral-50">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-16">
        <h2 class="text-3xl sm:text-4xl font-display font-bold text-neutral-900 mb-4">
          Our Leadership
        </h2>
        <p class="text-xl text-neutral-600 max-w-3xl mx-auto">
          Meet the passionate leaders who guide and shepherd our church community with love and dedication.
        </p>
      </div>
      
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
        <!-- Leader 1 -->
        <div class="bg-white rounded-2xl shadow-lg overflow-hidden hover:shadow-xl transition-shadow duration-300">
          <div class="h-64 bg-gradient-to-br from-primary-500 to-primary-600 flex items-center justify-center">
            <svg class="w-24 h-24 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"></path>
            </svg>
          </div>
          <div class="p-6">
            <h3 class="text-xl font-semibold text-neutral-900 mb-2">Pastor John Doe</h3>
            <p class="text-primary-600 font-medium mb-3">Senior Pastor</p>
            <p class="text-neutral-600 text-sm">
              Pastor John has been serving in ministry for over 15 years, leading with passion for God's Word and heart for the community.
            </p>
          </div>
        </div>

        <!-- Leader 2 -->
        <div class="bg-white rounded-2xl shadow-lg overflow-hidden hover:shadow-xl transition-shadow duration-300">
          <div class="h-64 bg-gradient-to-br from-secondary-500 to-secondary-600 flex items-center justify-center">
            <svg class="w-24 h-24 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"></path>
            </svg>
          </div>
          <div class="p-6">
            <h3 class="text-xl font-semibold text-neutral-900 mb-2">Pastor Sarah Johnson</h3>
            <p class="text-secondary-600 font-medium mb-3">Associate Pastor</p>
            <p class="text-neutral-600 text-sm">
              Pastor Sarah oversees our women's ministry and discipleship programs, bringing wisdom and compassion to her role.
            </p>
          </div>
        </div>

        <!-- Leader 3 -->
        <div class="bg-white rounded-2xl shadow-lg overflow-hidden hover:shadow-xl transition-shadow duration-300">
          <div class="h-64 bg-gradient-to-br from-primary-500 to-secondary-500 flex items-center justify-center">
            <svg class="w-24 h-24 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"></path>
            </svg>
          </div>
          <div class="p-6">
            <h3 class="text-xl font-semibold text-neutral-900 mb-2">Elder Michael Asante</h3>
            <p class="text-primary-600 font-medium mb-3">Youth Pastor & Elder</p>
            <p class="text-neutral-600 text-sm">
              Elder Michael leads our youth ministry and serves on the church board, passionate about raising the next generation.
            </p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- History & Location -->
  <section class="py-20 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-16 items-center">
        <div class="space-y-8">
          <div>
            <h2 class="text-3xl sm:text-4xl font-display font-bold text-neutral-900 mb-6">Our Story</h2>
            <div class="space-y-4 text-lg text-neutral-600 leading-relaxed">
              <p>
                Omet Omeni Ministries was established as a branch of Christian Life Centre with a vision to create a vibrant Christian community in the heart of Kumasi. Since our beginning, we have been committed to being a place where people can encounter God's love and grow in their faith.
              </p>
              <p>
                Located in the Conference Hall of Royal Cockpit Hotel in Ahodwo-Nhyiaeso, we have created a welcoming space where individuals and families from all walks of life can come together to worship, learn, and serve.
              </p>
              <p>
                Our journey has been marked by God's faithfulness as we've grown from a small gathering to a thriving community that impacts lives throughout Kumasi and beyond.
              </p>
            </div>
          </div>
          
          <div class="bg-gradient-to-br from-primary-50 to-secondary-50 p-6 rounded-xl">
            <h3 class="text-xl font-semibold text-neutral-900 mb-4">Our Location</h3>
            <div class="space-y-2 text-neutral-600">
              <p><strong>Conference Hall</strong></p>
              <p>Royal Cockpit Hotel</p>
              <p>Ahodwo-Nhyiaeso, Kumasi</p>
              <p>Ashanti Region, Ghana</p>
            </div>
          </div>
        </div>
        
        <div class="relative">
          <img 
            src="https://images.pexels.com/photos/1729931/pexels-photo-1729931.jpeg?auto=compress&cs=tinysrgb&w=800" 
            alt="Church building and community"
            class="w-full h-96 object-cover rounded-2xl shadow-2xl"
          />
          <div class="absolute -bottom-8 -left-8 w-40 h-40 bg-gradient-to-br from-primary-500/20 to-secondary-500/20 rounded-2xl"></div>
          <div class="absolute -top-8 -right-8 w-32 h-32 bg-gradient-to-br from-secondary-500/20 to-primary-500/20 rounded-2xl"></div>
        </div>
      </div>
    </div>
  </section>

  <!-- Call to Action -->
  <section class="py-20 bg-gradient-to-br from-primary-600 to-secondary-600 text-white">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <div class="space-y-8">
        <div>
          <h2 class="text-3xl sm:text-4xl font-display font-bold mb-4">
            Join Our Family
          </h2>
          <p class="text-xl opacity-90">
            We'd love to welcome you to Omet Omeni Ministries. Come and experience God's love in our community.
          </p>
        </div>
        
        <div class="flex flex-col sm:flex-row gap-4 justify-center">
          <a 
            href="/contact" 
            class="inline-flex items-center justify-center px-8 py-4 bg-white text-primary-600 font-semibold rounded-lg hover:bg-neutral-100 transition-colors"
          >
            Visit Us
            <svg class="ml-2 w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/>
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/>
            </svg>
          </a>
          <a 
            href="/events" 
            class="inline-flex items-center justify-center px-8 py-4 bg-transparent text-white font-semibold rounded-lg border-2 border-white/30 hover:bg-white/10 transition-colors"
          >
            View Upcoming Events
          </a>
        </div>
      </div>
    </div>
  </section>

  <Footer />
</Layout>