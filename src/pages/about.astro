---
import { Image } from 'astro:assets';
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import aboutHero from '../assets/oomi-about-hero.png';
import ometOmeniPortrait from '../assets/ometomeni-portrait.png';
import {
  beliefs,
  ministryMandate,
  ministryQualities,
  trustCommitments,
  visionMission,
} from '../data/about';
import { ministryLocations } from '../data/locations';

const presenceCopy = {
  ACCRA: {
    description: 'Selected programmes, office appointments and ministry activities.',
    action: 'Connect in Accra',
    href: '/plan-your-visit',
  },
  KUMASI: {
    description: 'Selected programmes, office support and ministry engagement.',
    action: 'Connect in Kumasi',
    href: '/events',
  },
  ONLINE: {
    description: 'Sermons, prayer, digital discipleship, livestreams and ministry resources.',
    action: 'Connect Online',
    href: '/contact',
  },
} as const;
---

<Layout
  title="About Omet Omeni Ministries | Vision, Beliefs and Leadership"
  description="Learn about Omet Omeni Ministries, its vision, mission, beliefs, leadership and ministry presence in Accra, Kumasi and online."
>
  <Header />
  <main id="main-content">
    <section class="relative isolate overflow-hidden bg-primary-900 text-white">
      <div class="absolute inset-0 -z-10" aria-hidden="true">
        <Image src={aboutHero} alt="" format="webp" quality={84} loading="eager" class="h-full w-full object-cover object-[72%_62%] sm:object-[68%_60%] lg:object-[center_58%]" />
        <div class="absolute inset-0 bg-[linear-gradient(90deg,rgba(10,15,28,0.97)_0%,rgba(10,15,28,0.88)_32%,rgba(10,15,28,0.42)_52%,rgba(10,15,28,0.06)_70%,transparent_100%)]"></div>
        <div class="absolute inset-0 bg-gradient-to-t from-neutral-950/20 via-transparent to-neutral-950/5"></div>
      </div>
      <div class="mx-auto flex min-h-[38rem] max-w-7xl items-center px-4 py-20 sm:min-h-[42rem] sm:px-6 sm:py-24 lg:px-8 lg:py-28">
        <div class="max-w-3xl lg:max-w-[52%]">
          <p class="text-sm font-semibold uppercase tracking-[0.2em] text-secondary-200">Our identity and purpose</p>
          <h1 class="mt-4 text-4xl font-display font-bold leading-tight sm:text-5xl lg:text-6xl">About Omet Omeni Ministries</h1>
          <p class="mt-6 max-w-3xl text-lg leading-relaxed text-primary-50 sm:text-xl">Omet Omeni Ministries is a Christ-centred ministry committed to proclaiming Jesus Christ, strengthening believers through biblical teaching and prayer, and equipping people to impact their generation.</p>
          <p class="mt-5 inline-flex rounded-full border border-secondary-200/30 bg-secondary-300/10 px-4 py-2 text-sm font-semibold text-secondary-100">Serving Accra, Kumasi and online.</p>
          <div class="mt-8 flex flex-col gap-4 sm:flex-row">
            <a href="/ministries" class="inline-flex min-h-12 items-center justify-center rounded-lg bg-secondary-300 px-6 py-3 font-semibold text-neutral-900 transition-colors hover:bg-secondary-200 focus:outline-none focus:ring-2 focus:ring-secondary-200 focus:ring-offset-2 focus:ring-offset-primary-900">Explore Our Ministries</a>
            <a href="/plan-your-visit" class="inline-flex min-h-12 items-center justify-center rounded-lg border border-white/50 px-6 py-3 font-semibold text-white transition-colors hover:bg-white/10 focus:outline-none focus:ring-2 focus:ring-white">Plan Your Visit</a>
          </div>
        </div>
      </div>
    </section>

    <section class="bg-white py-20" aria-labelledby="who-we-are-heading">
      <div class="mx-auto grid max-w-7xl gap-12 px-4 sm:px-6 lg:grid-cols-[0.9fr_1.1fr] lg:items-center lg:px-8">
        <div>
          <p class="text-sm font-semibold uppercase tracking-wider text-primary-700">Who we are</p>
          <h2 id="who-we-are-heading" class="mt-3 text-3xl font-display font-bold text-neutral-900 sm:text-4xl">Helping people know God, grow in Christ and live with purpose</h2>
        </div>
        <div>
          <p class="text-lg leading-relaxed text-neutral-600">Omet Omeni Ministries exists to help people know God, grow in Christ and live with spiritual purpose. Through biblical teaching, prayer, worship, discipleship and digital ministry, we serve individuals and communities in Accra, Kumasi and beyond.</p>
          <ul class="mt-8 flex flex-wrap gap-3" aria-label="Ministry qualities">
            {ministryQualities.map((quality) => <li class="rounded-full border border-primary-100 bg-primary-50 px-4 py-2 text-sm font-semibold text-primary-900">{quality}</li>)}
          </ul>
        </div>
      </div>
    </section>

    <section class="bg-neutral-950 py-20 text-white" aria-labelledby="vision-mission-heading">
      <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
        <div class="max-w-3xl">
          <p class="text-sm font-semibold uppercase tracking-wider text-secondary-300">Direction</p>
          <h2 id="vision-mission-heading" class="mt-3 text-3xl font-display font-bold sm:text-4xl">Our Vision and Mission</h2>
        </div>
        <div class="mt-12 grid gap-6 lg:grid-cols-2">
          {visionMission.map((item) => (
            <article class="rounded-2xl border border-secondary-300/25 bg-primary-900/50 p-8 sm:p-10">
              <div class="flex h-12 w-12 items-center justify-center rounded-xl bg-secondary-300/10 text-secondary-300 ring-1 ring-secondary-300/20" aria-hidden="true"><svg class="h-6 w-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.75" d={item.iconPath}></path></svg></div>
              <h3 class="mt-6 text-2xl font-semibold text-secondary-200">{item.eyebrow}</h3>
              <p class="mt-4 text-lg leading-relaxed text-neutral-100">{item.statement}</p>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="bg-gradient-to-b from-white to-primary-50/50 py-20" aria-labelledby="mandate-heading">
      <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
        <div class="mx-auto max-w-3xl text-center">
          <p class="text-sm font-semibold uppercase tracking-wider text-primary-700">What shapes our work</p>
          <h2 id="mandate-heading" class="mt-3 text-3xl font-display font-bold text-neutral-900 sm:text-4xl">Our Ministry Mandate</h2>
        </div>
        <div class="mt-12 grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
          {ministryMandate.map((pillar) => (
            <article class="rounded-2xl border border-primary-100 bg-white p-7 shadow-[0_18px_50px_-35px_rgba(30,58,138,0.55)]">
              <div class="flex h-12 w-12 items-center justify-center rounded-xl bg-primary-900 text-secondary-300" aria-hidden="true"><svg class="h-6 w-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.75" d={pillar.iconPath}></path></svg></div>
              <h3 class="mt-6 text-xl font-semibold text-neutral-900">{pillar.title}</h3>
              <p class="mt-3 leading-relaxed text-neutral-600">{pillar.description}</p>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="bg-white py-20" aria-labelledby="story-heading">
      <div class="mx-auto grid max-w-7xl gap-10 px-4 sm:px-6 lg:grid-cols-[0.7fr_1.3fr] lg:px-8">
        <div>
          <p class="text-sm font-semibold uppercase tracking-wider text-primary-700">Our story</p>
          <h2 id="story-heading" class="mt-3 text-3xl font-display font-bold text-neutral-900 sm:text-4xl">A ministry reaching beyond one location</h2>
        </div>
        <div>
          <div class="rounded-2xl border-l-4 border-secondary-400 bg-primary-50/70 p-8 sm:p-10">
            <p class="text-lg leading-relaxed text-neutral-700">Omet Omeni Ministries was established from a burden to proclaim Jesus Christ, strengthen believers through the Word and prayer, and reach people beyond the limits of a single physical location. The ministry is being developed through online teaching and prayer, supported by ministry offices and selected programmes in Accra and Kumasi.</p>
            <p class="mt-5 text-sm leading-relaxed text-neutral-500">Programme and office details are published only after confirmation. No founding date or growth timeline is stated until it has been reviewed and approved.</p>
          </div>
          <!-- TODO: Connect this action to an approved extended ministry-story route when available. -->
          <div class="mt-5 flex justify-end">
            <button type="button" disabled aria-disabled="true" title="Extended ministry story coming soon" class="inline-flex min-h-11 cursor-not-allowed items-center justify-center rounded-lg border border-primary-200 bg-white px-6 py-3 font-semibold text-primary-800 opacity-75 shadow-sm">Read More</button>
          </div>
        </div>
      </div>
    </section>

    <section class="bg-primary-50/60 py-20" aria-labelledby="beliefs-heading">
      <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
        <div class="flex flex-col gap-6 sm:flex-row sm:items-start sm:justify-between">
          <div class="max-w-3xl">
            <p class="text-sm font-semibold uppercase tracking-wider text-primary-700">Our foundation</p>
            <h2 id="beliefs-heading" class="mt-3 text-3xl font-display font-bold text-neutral-900 sm:text-4xl">What We Believe</h2>
            <p class="mt-4 text-lg leading-relaxed text-neutral-600">These concise statements summarise the ministry’s Christian convictions and remain subject to formal doctrinal review.</p>
          </div>
          <!-- TODO: Link to the approved full Statement of Faith when its route exists. -->
          <button type="button" disabled aria-disabled="true" title="Full Statement of Faith coming soon" class="inline-flex min-h-11 flex-none cursor-not-allowed items-center justify-center self-start rounded-lg border border-primary-200 bg-white px-6 py-3 font-semibold text-primary-800 opacity-75 shadow-sm">Know More</button>
        </div>
        <div class="mt-12 grid gap-5 md:grid-cols-2 lg:grid-cols-3">
          {beliefs.map((belief) => (
            <article class="rounded-xl border border-primary-100 bg-white p-6">
              <div class="flex h-10 w-10 items-center justify-center rounded-lg bg-primary-100 text-primary-800" aria-hidden="true"><svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.75" d={belief.iconPath}></path></svg></div>
              <h3 class="mt-5 text-lg font-semibold text-neutral-900">{belief.title}</h3>
              <p class="mt-2 leading-relaxed text-neutral-600">{belief.description}</p>
            </article>
          ))}
        </div>
        <!-- TODO: Link to a fuller Statement of Faith after an approved route and reviewed doctrinal text exist. -->
        <p class="mt-8 text-sm text-neutral-600">A fuller Statement of Faith will be published after ministry review.</p>
      </div>
    </section>

    <section class="relative isolate overflow-hidden bg-gradient-to-br from-neutral-950 via-neutral-900 to-secondary-900 py-20 text-white" aria-labelledby="lead-heading">
      <div class="absolute inset-0 -z-10 opacity-40" aria-hidden="true">
        <div class="absolute -left-32 top-1/4 h-72 w-72 rounded-full bg-neutral-700/30 blur-3xl"></div>
        <div class="absolute -right-24 bottom-0 h-80 w-80 rounded-full bg-secondary-700/25 blur-3xl"></div>
      </div>
      <div class="mx-auto grid max-w-6xl gap-10 px-4 sm:px-6 lg:grid-cols-[0.45fr_1fr] lg:items-center lg:px-8">
        <div class="relative mx-auto w-full max-w-sm">
          <div class="relative rounded-3xl border border-secondary-200/30 bg-primary-900 shadow-2xl">
            <Image src={ometOmeniPortrait} alt="Omet Omeni, Founder and Ministry Lead" format="webp" quality={86} loading="lazy" class="aspect-[4/5] h-full w-full rounded-3xl object-cover object-top" />
            <div class="absolute inset-x-0 bottom-0 h-24 rounded-b-3xl bg-gradient-to-t from-neutral-950/85 to-transparent" aria-hidden="true"></div>
          </div>
          <p class="signature-script mt-7 -rotate-2 whitespace-nowrap text-center text-[clamp(1.6rem,5.5vw,2.1rem)] leading-[1.05] text-secondary-100 drop-shadow-[0_2px_4px_rgba(0,0,0,0.9)]" aria-label="Rev. Omet Yawelis Omeni">Rev. Omet Yawelis Omeni</p>
          <div class="mx-auto mt-4 h-px w-3/5 bg-secondary-300 shadow-[0_0_9px_rgba(252,211,77,0.75)]" aria-hidden="true"></div>
          <p class="mt-3 whitespace-nowrap text-center text-xs font-medium uppercase tracking-[0.14em] text-neutral-200 sm:text-sm">
            <span>Preacher</span><span class="mx-2 text-base leading-none text-secondary-300" aria-hidden="true">•</span><span>Teacher</span><span class="mx-2 text-base leading-none text-secondary-300" aria-hidden="true">•</span><span>Leader</span>
          </p>
        </div>
        <div>
          <p class="text-sm font-semibold uppercase tracking-wider text-secondary-300">Meet the ministry lead</p>
          <h2 id="lead-heading" class="mt-3 text-3xl font-display font-bold sm:text-4xl">Omet Omeni</h2>
          <p class="mt-2 font-semibold text-secondary-200">Founder and Ministry Lead</p>
          <p class="mt-6 text-lg leading-relaxed text-neutral-200">Omet Omeni provides spiritual and strategic leadership for Omet Omeni Ministries. His ministry focus includes biblical teaching, prayer, discipleship, leadership development and online outreach. Through the ministry’s work in Accra, Kumasi and online, he seeks to help believers grow in Christ and fulfil their God-given purpose.</p>
          <div class="mt-8 rounded-xl border border-white/10 bg-white/5 p-6">
            <h3 class="text-lg font-semibold text-white">Ministry Leadership Team</h3>
            <p class="mt-3 leading-relaxed text-neutral-300">Approved ministry workers support teaching, prayer, administration, safeguarding and programme delivery under responsible oversight. Team profiles will be published only after ministry review.</p>
            <button type="button" disabled aria-disabled="true" class="mt-6 inline-flex min-h-11 cursor-not-allowed items-center justify-center rounded-lg border border-white/20 bg-white/10 px-5 py-3 font-semibold text-white/60 opacity-75">Meet The Team <span class="ml-2 text-xs font-medium uppercase tracking-wider">(Coming soon)</span></button>
          </div>
        </div>
      </div>
    </section>

    <section class="bg-white py-20" aria-labelledby="presence-heading">
      <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
        <div class="mx-auto max-w-3xl text-center">
          <p class="text-sm font-semibold uppercase tracking-wider text-primary-700">Where and how we serve</p>
          <h2 id="presence-heading" class="mt-3 text-3xl font-display font-bold text-neutral-900 sm:text-4xl">Accra, Kumasi and Online</h2>
          <p class="mt-4 text-lg text-neutral-600">Connect through confirmed local activities or approved online ministry programmes.</p>
        </div>
        <div class="mt-12 grid gap-6 lg:grid-cols-3">
          {ministryLocations.map((location) => {
            const content = presenceCopy[location.id];
            return (
              <article class="flex flex-col rounded-2xl border border-neutral-200 bg-neutral-50 p-8">
                <p class="text-sm font-semibold uppercase tracking-wider text-primary-700">{location.generalArea}</p>
                <h3 class="mt-3 text-2xl font-semibold text-neutral-900">{location.id === 'ONLINE' ? 'Online' : location.id === 'ACCRA' ? 'Accra' : 'Kumasi'}</h3>
                <p class="mt-4 flex-1 leading-relaxed text-neutral-600">{content.description}</p>
                <p class="mt-5 text-sm leading-relaxed text-neutral-500">{location.registrationInstructions}</p>
                <a href={content.href} class="mt-7 inline-flex min-h-11 items-center justify-center rounded-lg bg-primary-700 px-5 py-3 font-semibold text-white hover:bg-primary-800 focus:outline-none focus:ring-2 focus:ring-primary-500 focus:ring-offset-2">{content.action}</a>
              </article>
            );
          })}
        </div>
      </div>
    </section>

    <section class="border-y border-secondary-200/50 bg-secondary-50/50 py-20" aria-labelledby="governance-heading">
      <div class="mx-auto grid max-w-7xl gap-10 px-4 sm:px-6 lg:grid-cols-[1fr_1.1fr] lg:px-8">
        <div>
          <p class="text-sm font-semibold uppercase tracking-wider text-primary-700">Governance and trust</p>
          <h2 id="governance-heading" class="mt-3 text-3xl font-display font-bold text-neutral-900 sm:text-4xl">Spiritually faithful and operationally responsible</h2>
          <p class="mt-5 text-lg leading-relaxed text-neutral-700">We believe ministry should be spiritually faithful and operationally responsible. Omet Omeni Ministries is committed to biblical accountability, safeguarding, financial integrity, respectful ministry practices and responsible handling of personal information.</p>
          <a href="/contact" class="mt-7 inline-flex font-semibold text-primary-800 underline decoration-primary-300 underline-offset-4 focus:outline-none focus:ring-2 focus:ring-primary-500">Contact the ministry about governance or safeguarding</a>
          <!-- TODO: Add approved safeguarding, privacy, and giving-accountability links when those routes exist. -->
        </div>
        <ul class="grid gap-3 sm:grid-cols-2">
          {trustCommitments.map((commitment) => (
            <li class="flex items-start gap-3 rounded-xl border border-secondary-200 bg-white p-4 text-neutral-800">
              <svg class="mt-0.5 h-5 w-5 flex-none text-primary-700" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 12l4 4L19 6"></path></svg>
              <span class="font-medium">{commitment}</span>
            </li>
          ))}
        </ul>
      </div>
    </section>

    <section class="bg-gradient-to-br from-primary-900 via-primary-800 to-neutral-950 py-20 text-white" aria-labelledby="next-step-heading">
      <div class="mx-auto max-w-4xl px-4 text-center sm:px-6 lg:px-8">
        <p class="text-sm font-semibold uppercase tracking-wider text-secondary-300">Continue the journey</p>
        <h2 id="next-step-heading" class="mt-3 text-3xl font-display font-bold sm:text-4xl">Take Your Next Step</h2>
        <p class="mx-auto mt-5 max-w-2xl text-lg leading-relaxed text-primary-100">Connect with Omet Omeni Ministries through teaching, prayer, discipleship and approved programmes in Accra, Kumasi or online.</p>
        <div class="mt-8 flex flex-col flex-wrap justify-center gap-4 sm:flex-row">
          <a href="/plan-your-visit" class="inline-flex min-h-12 items-center justify-center rounded-lg bg-secondary-300 px-6 py-3 font-semibold text-neutral-900 hover:bg-secondary-200 focus:outline-none focus:ring-2 focus:ring-secondary-200 focus:ring-offset-2 focus:ring-offset-primary-900">Plan Your Visit</a>
          <a href="/sermons" class="inline-flex min-h-12 items-center justify-center rounded-lg border border-white/50 px-6 py-3 font-semibold text-white hover:bg-white/10 focus:outline-none focus:ring-2 focus:ring-white">View Sermons</a>
          <a href="/contact" class="inline-flex min-h-12 items-center justify-center rounded-lg px-6 py-3 font-semibold text-white underline decoration-white/40 underline-offset-4 focus:outline-none focus:ring-2 focus:ring-white">Contact the Ministry</a>
        </div>
      </div>
    </section>
  </main>
  <Footer />
</Layout>

<style>
  .signature-script {
    font-family: "Vladimir Script", "Brush Script MT", "Segoe Script", cursive;
    font-style: normal;
    font-weight: 400;
    letter-spacing: 0;
  }
</style>
