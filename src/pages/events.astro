                <div class="text-primary-600 font-bold text-lg">
                  {new Date(event.date).getDate()}
                </div>
                <div class="text-neutral-600 text-xs uppercase">
                  {new Date(event.date).toLocaleDateString('en-US', { month: 'short' })}
