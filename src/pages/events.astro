---
import { Image } from 'astro:assets';
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import NewsletterSignup from '../components/newsletter/NewsletterSignup.astro';
import EventCard from '../components/events/EventCard.astro';
import EventFilters from '../components/events/EventFilters.astro';
import FeaturedProgrammeCard from '../components/events/FeaturedProgrammeCard.astro';
import RecurringProgrammeCard from '../components/events/RecurringProgrammeCard.astro';
import EventResponseModal from '../components/events/EventResponseModal.astro';
import heroImage from '../assets/events-page-hero.png';
import { featuredProgrammes, getPastEventHighlights, getUpcomingApprovedEvents, recurringProgrammes } from '../data/events';

const upcomingEvents = getUpcomingApprovedEvents();
const pastHighlights = getPastEventHighlights();
const activeProgrammes = recurringProgrammes.filter((programme) => programme.approved && programme.status === 'ACTIVE');
const programmeCadences = ['WEEKLY', 'MONTHLY', 'QUARTERLY'] as const;
---

<Layout title="Events and Ministry Experiences | Omet Omeni Ministries" description="Discover upcoming Omet Omeni Ministries programmes in Accra, Kumasi and online, including biblical teaching, prayer, worship, discipleship, leadership and special ministry events.">
  <Header />
  <main id="main-content">
    <section class="relative isolate overflow-hidden bg-neutral-950 text-white">
      <div class="absolute inset-0 -z-10" aria-hidden="true"><Image src={heroImage} alt="" format="webp" quality={80} loading="eager" class="h-full w-full object-cover object-center" /><div class="absolute inset-0 bg-gradient-to-r from-neutral-950/95 via-primary-900/80 to-neutral-950/30"></div></div>
      <div class="mx-auto max-w-7xl px-4 py-20 sm:px-6 sm:py-24 lg:px-8">
        <div class="max-w-4xl">
          <p class="text-sm font-semibold uppercase tracking-[0.2em] text-secondary-300">Gather, grow and connect</p>
          <h1 class="mt-4 text-4xl font-display font-bold sm:text-5xl lg:text-6xl">Events and Ministry Experiences</h1>
          <p class="mt-6 max-w-3xl text-lg leading-relaxed text-primary-50 sm:text-xl">Join Omet Omeni Ministries through biblical teaching, prayer, worship, discipleship and special programmes in Accra, Kumasi and online.</p>
          <div class="mt-8 flex flex-col gap-4 sm:flex-row"><a href="#upcoming-events" class="inline-flex min-h-12 items-center justify-center rounded-lg bg-secondary-300 px-6 py-3 font-semibold text-neutral-900 hover:bg-secondary-200">View Upcoming Events</a><a href="/plan-your-visit" class="inline-flex min-h-12 items-center justify-center rounded-lg border border-white/50 px-6 py-3 font-semibold text-white hover:bg-white/10">Plan Your Visit</a></div>
        </div>
        <div class="mt-12 grid max-w-3xl grid-cols-3 gap-3">
          {['Accra', 'Kumasi', 'Online'].map((location) => <a href={`#upcoming-events`} data-hero-location={location.toUpperCase()} class="rounded-xl border border-white/20 bg-white/10 p-4 text-center font-semibold backdrop-blur-sm hover:bg-white/15 focus:outline-none focus:ring-2 focus:ring-white">{location}</a>)}
        </div>
      </div>
    </section>

    <section class="bg-white py-20" aria-labelledby="featured-heading">
      <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
        <p class="text-sm font-semibold uppercase tracking-wider text-primary-700">Ministry highlights</p>
        <h2 id="featured-heading" class="mt-3 text-3xl font-display font-bold text-neutral-900 sm:text-4xl">Featured Events</h2>
        <p class="mt-4 max-w-3xl text-lg text-neutral-600">Explore these upcoming ministry gatherings. Dates, venues and access details will be shared when confirmed.</p>
        <div class="mt-10 grid items-stretch gap-8 md:grid-cols-2">
          {featuredProgrammes.map((programme) => <FeaturedProgrammeCard programme={programme} />)}
        </div>
      </div>
    </section>

    <section id="upcoming-events" class="scroll-mt-24 bg-primary-50/50 py-20" aria-labelledby="upcoming-heading">
      <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
        <div class="max-w-3xl"><p class="text-sm font-semibold uppercase tracking-wider text-primary-700">Find your next step</p><h2 id="upcoming-heading" class="mt-3 text-3xl font-display font-bold text-neutral-900 sm:text-4xl">Upcoming Events</h2><p class="mt-4 text-lg text-neutral-600">Filter confirmed programmes by location, format, category or month.</p></div>
        <div class="mt-10"><EventFilters /></div>
        <div id="events-grid" class="mt-10 grid items-stretch gap-7 md:grid-cols-2 lg:grid-cols-3" hidden={upcomingEvents.length === 0}>
          {upcomingEvents.map((event) => <EventCard event={event} />)}
        </div>
        {upcomingEvents.length === 0 && <div id="upcoming-default-state" class="mt-10 rounded-2xl border border-primary-100 bg-white p-10 text-center"><h3 class="text-2xl font-semibold text-neutral-900">No additional upcoming events are currently published</h3><p class="mx-auto mt-3 max-w-2xl text-neutral-600">Use the filters to find matching Featured Events above, or subscribe while further programme details are being prepared.</p><a href="/sermons" class="mt-6 inline-flex font-semibold text-primary-800 underline underline-offset-4">Explore sermons</a></div>}
        <div id="events-empty-state" hidden class="mt-10 rounded-xl border border-neutral-200 bg-white p-8 text-center text-neutral-700" role="status">No upcoming events match these filters.</div>
      </div>
    </section>

    <section class="bg-white py-20" aria-labelledby="regular-heading">
      <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
        <div class="max-w-3xl"><p class="text-sm font-semibold uppercase tracking-wider text-primary-700">Ongoing formation</p><h2 id="regular-heading" class="mt-3 text-3xl font-display font-bold text-neutral-900 sm:text-4xl">Regular Ministry Programmes</h2></div>
        {activeProgrammes.length > 0
          ? <>
              <div class="mt-8 flex flex-wrap gap-3" role="group" aria-label="Filter regular ministry programmes">
                {programmeCadences.map((cadence) => <button
                  type="button"
                  data-programme-filter={cadence}
                  aria-pressed="false"
                  class="min-h-11 rounded-full border border-primary-200 bg-white px-5 py-2 font-semibold text-primary-800 transition hover:border-primary-500 hover:bg-primary-50 focus:outline-none focus:ring-2 focus:ring-primary-500 aria-pressed:border-primary-700 aria-pressed:bg-primary-700 aria-pressed:text-white"
                >{cadence.charAt(0) + cadence.slice(1).toLowerCase()}</button>)}
              </div>
              <p id="programme-filter-status" class="mt-4 text-sm font-medium text-neutral-600" role="status" aria-live="polite">Showing all regular programmes.</p>
              <div id="programme-grid" class="mt-8 grid items-stretch gap-7 md:grid-cols-2 lg:grid-cols-3">
                {activeProgrammes.map((programme) => <div class="h-full" data-programme-card data-cadence={programme.cadence}><RecurringProgrammeCard programme={programme} /></div>)}
              </div>
            </>
          : <div class="mt-10 rounded-2xl border border-neutral-200 bg-neutral-50 p-8"><h3 class="text-xl font-semibold text-neutral-900">Regular ministry programmes are being finalised.</h3><p class="mt-3 text-neutral-600">Subscribe for updates or view confirmed upcoming events.</p></div>}
      </div>
    </section>

    {pastHighlights.length > 0 && <section class="bg-neutral-950 py-20 text-white" aria-labelledby="highlights-heading"><div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8"><h2 id="highlights-heading" class="text-3xl font-display font-bold sm:text-4xl">Past Event Highlights and Recordings</h2><div class="mt-10 grid gap-6 md:grid-cols-3">{pastHighlights.map((event) => <article class="rounded-xl border border-white/15 bg-white/5 p-6"><h3 class="text-xl font-semibold">{event.title}</h3><div class="mt-5 flex flex-wrap gap-4">{event.recordingUrl && <a href={event.recordingUrl}>Watch Recording</a>}{event.sermonUrl && <a href={event.sermonUrl}>View Sermon</a>}{event.recapUrl && <a href={event.recapUrl}>Read Event Recap</a>}</div></article>)}</div></div></section>}

    <section class="bg-gradient-to-br from-primary-900 to-neutral-950 py-20 text-white" aria-labelledby="updates-heading"><div class="mx-auto max-w-3xl px-4 sm:px-6 lg:px-8"><div class="rounded-2xl border border-white/15 bg-white/10 p-7 backdrop-blur-sm sm:p-10"><NewsletterSignup source="EVENTS" title="Stay Updated" description="Receive selected event announcements, prayer programmes and ministry updates from Omet Omeni Ministries." defaultInterests={['EVENTS', 'GENERAL_UPDATES']} dark /></div></div></section>

    <section class="bg-secondary-50 py-20" aria-labelledby="event-help-heading"><div class="mx-auto max-w-4xl px-4 text-center sm:px-6 lg:px-8"><h2 id="event-help-heading" class="text-3xl font-display font-bold text-neutral-900 sm:text-4xl">Need Help Planning Your Visit?</h2><p class="mx-auto mt-5 max-w-2xl text-lg text-neutral-700">Our team can help you choose an event, request an appointment or connect online in Accra, Kumasi or through our digital ministry.</p><div class="mt-8 flex flex-col justify-center gap-4 sm:flex-row"><a href="/plan-your-visit" class="rounded-lg bg-primary-800 px-6 py-3 font-semibold text-white">Plan Your Visit</a><a href="/contact" class="rounded-lg border border-primary-200 bg-white px-6 py-3 font-semibold text-primary-800">Contact the Ministry</a><a href="/sermons" class="px-6 py-3 font-semibold text-primary-800 underline">View Sermons</a></div></div></section>
    <EventResponseModal />
  </main>
  <Footer />
</Layout>

<script>
  const filters = document.querySelector<HTMLFormElement>('#event-filters');
  if (filters) {
    const cards = Array.from(document.querySelectorAll<HTMLElement>('[data-event-card]'));
    const featuredCards = cards.filter((card) => card.hasAttribute('data-featured-event'));
    const featuredHomes = new Map(featuredCards.map((card) => {
      const marker = document.createComment('featured-event-home');
      card.before(marker);
      return [card, marker] as const;
    }));
    const grid = document.querySelector<HTMLElement>('#events-grid');
    const count = document.querySelector<HTMLElement>('#event-result-count');
    const empty = document.querySelector<HTMLElement>('#events-empty-state');
    const defaultState = document.querySelector<HTMLElement>('#upcoming-default-state');
    const applyFilters = () => {
      const data = new FormData(filters);
      const values = { location: String(data.get('location') || ''), format: String(data.get('format') || ''), category: String(data.get('category') || ''), month: String(data.get('month') || '') };
      const filtering = Object.values(values).some(Boolean);
      let visible = 0;
      cards.forEach((card) => {
        const locations = (card.dataset.location ?? '').split(' ');
        const match = (!values.location || locations.includes(values.location)) && (!values.format || card.dataset.format === values.format) && (!values.category || card.dataset.category === values.category) && (!values.month || card.dataset.month === values.month);
        card.hidden = filtering && !match;
        if (match) visible += 1;
      });
      featuredCards.forEach((card) => {
        const marker = featuredHomes.get(card);
        if (!marker?.parentNode) return;
        if (filtering && !card.hidden && grid) {
          grid.append(card);
        } else if (card.previousSibling !== marker) {
          marker.parentNode.insertBefore(card, marker.nextSibling);
        }
      });
      const resultHasCards = filtering && visible > 0;
      if (grid) grid.hidden = !resultHasCards && grid.querySelectorAll('[data-featured-event]').length === grid.children.length;
      if (defaultState) defaultState.hidden = filtering;
      if (count) count.textContent = `${visible} ${visible === 1 ? 'event' : 'events'} found across Featured and Upcoming Events`;
      if (empty) empty.hidden = !filtering || visible !== 0;
      const query = new URLSearchParams(Object.entries(values).filter(([, value]) => value));
      history.replaceState(null, '', `${location.pathname}${query.size ? `?${query}` : ''}${location.hash}`);
    };
    const initial = new URLSearchParams(location.search);
    filters.querySelectorAll<HTMLInputElement | HTMLSelectElement>('input, select').forEach((control) => { const value = initial.get(control.name); if (value) control.value = value; });
    filters.addEventListener('change', applyFilters);
    filters.addEventListener('reset', () => requestAnimationFrame(applyFilters));
    document.querySelectorAll<HTMLElement>('[data-hero-location]').forEach((link) => link.addEventListener('click', () => {
      const select = filters.querySelector<HTMLSelectElement>('[name="location"]'); if (select) select.value = link.dataset.heroLocation ?? ''; applyFilters();
    }));
    applyFilters();
  }
</script>

<script>
  const programmeButtons = Array.from(document.querySelectorAll<HTMLButtonElement>('[data-programme-filter]'));
  const programmeCards = Array.from(document.querySelectorAll<HTMLElement>('[data-programme-card]'));
  const programmeStatus = document.querySelector<HTMLElement>('#programme-filter-status');
  let activeCadence = '';

  const applyProgrammeFilter = () => {
    programmeCards.forEach((card) => {
      card.hidden = Boolean(activeCadence) && card.dataset.cadence !== activeCadence;
    });
    programmeButtons.forEach((button) => {
      button.setAttribute('aria-pressed', String(button.dataset.programmeFilter === activeCadence));
    });
    if (programmeStatus) {
      programmeStatus.textContent = activeCadence
        ? `Showing ${activeCadence.toLowerCase()} programmes.`
        : 'Showing all regular programmes.';
    }
  };

  programmeButtons.forEach((button) => {
    button.addEventListener('click', () => {
      const selected = button.dataset.programmeFilter ?? '';
      activeCadence = activeCadence === selected ? '' : selected;
      applyProgrammeFilter();
    });
  });
</script>
