];

// Helper function to format date
function formatDate(dateString: string) {
  const date = new Date(dateString);
  return date.toLocaleDateString('en-US', { 
    weekday: 'long', 
    year: 'numeric', 
    month: 'long', 
    day: 'numeric' 
  });
}

// Helper function to get days until event
function getDaysUntil(dateString: string) {
  const eventDate = new Date(dateString);
  const today = new Date();
  const diffTime = eventDate.getTime() - today.getTime();
  const diffDays = Math.ceil(diffTime / (1000 * 60 * 60 * 24));
  return diffDays;
}
---

<Layout 
  title="Events & Programs | Omet Omeni Ministries - Join Our Community Activities" 
  description="Discover upcoming events, services, and programs at Omet Omeni Ministries in Kumasi, Ghana. Join us for worship, fellowship, youth activities, and community outreach."
>
  <Header />
  
  <!-- Hero Section -->
  <section class="relative bg-gradient-to-br from-primary-50 via-white to-secondary-50 py-20">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center">
        <h1 class="text-4xl sm:text-5xl lg:text-6xl font-display font-bold text-neutral-900 mb-6">
          Events & <span class="text-transparent bg-clip-text bg-gradient-to-r from-primary-600 to-secondary-600">Programs</span>
        </h1>
        <p class="text-xl text-neutral-600 max-w-3xl mx-auto mb-8">
          Join us for worship, fellowship, and community activities. There's always something happening at Omet Omeni Ministries!
        </p>
        
        <!-- Quick Service Times -->
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4 max-w-4xl mx-auto">
          <div class="bg-white p-4 rounded-lg shadow-md border border-neutral-100">
            <div class="text-primary-600 font-semibold text-sm">SUNDAY</div>
            <div class="text-neutral-900 font-medium">9:00 AM</div>
            <div class="text-neutral-600 text-sm">Worship Service</div>
          </div>
          <div class="bg-white p-4 rounded-lg shadow-md border border-neutral-100">
            <div class="text-secondary-600 font-semibold text-sm">WEDNESDAY</div>
            <div class="text-neutral-900 font-medium">6:00 PM</div>
            <div class="text-neutral-600 text-sm">Bible Study</div>
          </div>
          <div class="bg-white p-4 rounded-lg shadow-md border border-neutral-100">
            <div class="text-primary-600 font-semibold text-sm">FRIDAY</div>
            <div class="text-neutral-900 font-medium">6:00 PM</div>
            <div class="text-neutral-600 text-sm">Prayer Meeting</div>
          </div>
          <div class="bg-white p-4 rounded-lg shadow-md border border-neutral-100">
            <div class="text-secondary-600 font-semibold text-sm">SATURDAY</div>
            <div class="text-neutral-900 font-medium">4:00 PM</div>
            <div class="text-neutral-600 text-sm">Youth Service</div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Featured Events -->
  <section class="py-20 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-16">
        <h2 class="text-3xl sm:text-4xl font-display font-bold text-neutral-900 mb-4">
          Featured Events
        </h2>
        <p class="text-xl text-neutral-600">
          Don't miss these special upcoming events at Omet Omeni Ministries
        </p>
      </div>
      
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-8">
        {upcomingEvents.filter(event => event.featured).map((event) => (
          <div class="bg-white rounded-2xl shadow-xl overflow-hidden hover:shadow-2xl transition-shadow duration-300 border border-neutral-100">
            <div class="relative h-64">
              <img 
                src={event.image} 
                alt={event.title}
                class="w-full h-full object-cover"
              />
              <div class="absolute top-4 left-4">
                <span class="bg-primary-600 text-white px-3 py-1 rounded-full text-sm font-medium">
