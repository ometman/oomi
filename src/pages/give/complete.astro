---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
---

<Layout title="Payment Status | Omet Omeni Ministries" description="Verify the status of an online gift to Omet Omeni Ministries.">
  <Header />
  <main class="min-h-[60vh] bg-neutral-50 py-20">
    <section class="mx-auto max-w-xl px-4 sm:px-6" aria-labelledby="payment-status-heading">
      <div class="rounded-2xl border border-neutral-200 bg-white p-8 shadow-sm sm:p-10">
        <p class="text-sm font-semibold uppercase tracking-wider text-primary-600">Online giving</p>
        <h1 id="payment-status-heading" class="mt-3 text-3xl font-display font-bold text-neutral-900">Checking your payment</h1>
        <p id="payment-status" class="mt-4 text-neutral-600" role="status" aria-live="polite">Please wait while we verify the transaction directly with Paystack.</p>
        <dl id="payment-details" hidden class="mt-6 space-y-3 rounded-lg bg-neutral-50 p-5 text-sm">
          <div><dt class="font-semibold text-neutral-900">Reference</dt><dd id="payment-reference" class="mt-1 break-all text-neutral-700"></dd></div>
          <div><dt class="font-semibold text-neutral-900">Amount</dt><dd id="payment-amount" class="mt-1 text-neutral-700"></dd></div>
          <div><dt class="font-semibold text-neutral-900">Designation</dt><dd id="payment-designation" class="mt-1 text-neutral-700"></dd></div>
        </dl>
        <div class="mt-8 flex flex-wrap gap-4"><a href="/give" class="font-semibold text-primary-700 underline">Return to giving</a><a href="/contact" class="font-semibold text-primary-700 underline">Contact the ministry</a></div>
      </div>
    </section>
  </main>
  <Footer />
</Layout>

<script>
  import { validatePaymentReference } from '../../lib/giving';
  const status = document.querySelector<HTMLElement>('#payment-status')!;
  const reference = validatePaymentReference(new URLSearchParams(window.location.search).get('reference'));
  if (!reference) {
    status.className = 'mt-4 font-medium text-red-700'; status.textContent = 'No valid payment reference was provided. No payment status can be confirmed.';
  } else {
    fetch(`/api/giving/verify?reference=${encodeURIComponent(reference)}`, { headers: { Accept: 'application/json' } })
      .then(async (response) => {
        const result = await response.json().catch(() => ({}));
        if (!response.ok || !['SUCCESS', 'PENDING', 'FAILED'].includes(result.status)) throw new Error();
        status.className = result.status === 'SUCCESS' ? 'mt-4 font-medium text-green-700' : result.status === 'PENDING' ? 'mt-4 font-medium text-amber-700' : 'mt-4 font-medium text-red-700';
        status.textContent = result.status === 'SUCCESS'
          ? 'Your payment has been verified successfully. Thank you for your generosity.'
          : result.status === 'PENDING'
            ? 'This payment is still pending. Please complete any provider prompt and check again shortly.'
            : 'Paystack did not confirm this payment as successful. Please try again or contact the ministry with the reference below.';
        const details = document.querySelector<HTMLElement>('#payment-details')!; details.hidden = false;
        document.querySelector<HTMLElement>('#payment-reference')!.textContent = result.reference;
        document.querySelector<HTMLElement>('#payment-amount')!.textContent = typeof result.amountGhs === 'number' ? `GHS ${result.amountGhs.toFixed(2)}` : 'Not available';
        document.querySelector<HTMLElement>('#payment-designation')!.textContent = typeof result.designation === 'string' ? result.designation.replaceAll('_', ' ') : 'Not available';
      })
      .catch(() => {
        status.className = 'mt-4 font-medium text-red-700'; status.textContent = 'We could not verify this payment yet. Keep your Paystack reference and try again shortly.';
      });
  }
</script>
