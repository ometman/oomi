---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
---

<Layout 
  title="Contact Us | Omet Omeni Ministries - Get in Touch" 
  description="Contact Omet Omeni Ministries in Kumasi, Ghana. Find our location, service times, phone number, and email. We'd love to hear from you and welcome you to our community."
>
  <Header />
  
  <!-- Hero Section -->
  <section class="relative bg-gradient-to-br from-primary-50 via-white to-secondary-50 py-20">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center">
        <h1 class="text-4xl sm:text-5xl lg:text-6xl font-display font-bold text-neutral-900 mb-6">
          Get In <span class="text-transparent bg-clip-text bg-gradient-to-r from-primary-600 to-secondary-600">Touch</span>
        </h1>
        <p class="text-xl text-neutral-600 max-w-3xl mx-auto">
          We'd love to hear from you. Reach out with any questions, prayer requests, or just to say hello. We're here for you.
        </p>
      </div>
    </div>
  </section>

  <!-- Contact Information & Form -->
  <section class="py-20 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-16">
        
        <!-- Contact Information -->
        <div class="space-y-8">
          <div>
            <h2 class="text-3xl font-display font-bold text-neutral-900 mb-6">Contact Information</h2>
            <p class="text-lg text-neutral-600 mb-8">
              Here's how you can reach us. We respond to all messages within 24 hours.
            </p>
          </div>
          
          <!-- Contact Cards -->
          <div class="space-y-6">
            <!-- Location -->
            <div class="bg-gradient-to-br from-primary-50 to-primary-100 p-6 rounded-xl">
              <div class="flex items-start space-x-4">
                <div class="w-12 h-12 bg-primary-600 rounded-xl flex items-center justify-center flex-shrink-0">
                  <svg class="w-6 h-6 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
                  </svg>
                </div>
                <div>
                  <h3 class="text-lg font-semibold text-neutral-900 mb-2">Our Location</h3>
                  <div class="text-neutral-600">
                    <p>Conference Hall</p>
                    <p>Royal Cockpit Hotel</p>
                    <p>Ahodwo-Nhyiaeso, Kumasi</p>
                    <p>Ashanti Region, Ghana</p>
                  </div>
                </div>
              </div>
            </div>

            <!-- Email -->
            <div class="bg-gradient-to-br from-neutral-50 to-neutral-100 p-6 rounded-xl">
              <div class="flex items-start space-x-4">
                <div class="w-12 h-12 bg-neutral-600 rounded-xl flex items-center justify-center flex-shrink-0">
                  <svg class="w-6 h-6 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
                  </svg>
                </div>
                <div>
                  <h3 class="text-lg font-semibold text-neutral-900 mb-2">Email Addresses</h3>
                  <div class="space-y-1 text-neutral-600">
                    <a href="mailto:hello@ometomeni.org" class="block hover:text-neutral-700 transition-colors">hello@ometomeni.org</a>
                  </div>
                </div>
              </div>
            </div>
          </div>

          <!-- Service Times -->
          <div class="bg-white border-2 border-neutral-100 p-6 rounded-xl">
            <h3 class="text-xl font-semibold text-neutral-900 mb-4">Service Times</h3>
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
              <div>
                <p class="font-medium text-neutral-900">Sunday Service</p>
                <p class="text-neutral-600">9:00 AM - 11:30 AM</p>
              </div>
              <div>
                <p class="font-medium text-neutral-900">Bible Study</p>
                <p class="text-neutral-600">Wednesday 6:00 PM</p>
              </div>
              <div>
                <p class="font-medium text-neutral-900">Prayer Meeting</p>
                <p class="text-neutral-600">Friday 6:00 PM</p>
              </div>
              <div>
                <p class="font-medium text-neutral-900">Youth Service</p>
                <p class="text-neutral-600">Saturday 4:00 PM</p>
              </div>
            </div>
          </div>
        </div>

        <!-- Contact Form -->
        <div class="bg-neutral-50 p-8 rounded-2xl">
          <div class="mb-8">
            <h2 class="text-3xl font-display font-bold text-neutral-900 mb-4">Send us a Message</h2>
            <p class="text-neutral-600">
              Have questions, prayer requests, or want to get involved? Fill out the form below and we'll get back to you soon.
            </p>
          </div>
          
          <form class="space-y-6" id="contact-form">
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
              <div>
                <label for="first-name" class="block text-sm font-medium text-neutral-700 mb-2">First Name</label>
                <input 
                  type="text" 
                  id="first-name" 
                  name="first-name" 
                  required
                  class="w-full px-4 py-3 bg-white border border-neutral-200 rounded-lg focus:ring-2 focus:ring-primary-500 focus:border-transparent transition-colors"
                  placeholder="Your first name"
                />
              </div>
              <div>
                <label for="last-name" class="block text-sm font-medium text-neutral-700 mb-2">Last Name</label>
                <input 
                  type="text" 
                  id="last-name" 
                  name="last-name" 
                  required
                  class="w-full px-4 py-3 bg-white border border-neutral-200 rounded-lg focus:ring-2 focus:ring-primary-500 focus:border-transparent transition-colors"
                  placeholder="Your last name"
                />
              </div>
            </div>
            
            <div>
              <label for="email" class="block text-sm font-medium text-neutral-700 mb-2">Email Address</label>
              <input 
                type="email" 
                id="email" 
                name="email" 
                required
                class="w-full px-4 py-3 bg-white border border-neutral-200 rounded-lg focus:ring-2 focus:ring-primary-500 focus:border-transparent transition-colors"
                placeholder="your.email@example.com"
              />
            </div>
            
            <div>
              <label for="phone" class="block text-sm font-medium text-neutral-700 mb-2">Phone Number (Optional)</label>
              <input 
                type="tel" 
                id="phone" 
                name="phone"
                class="w-full px-4 py-3 bg-white border border-neutral-200 rounded-lg focus:ring-2 focus:ring-primary-500 focus:border-transparent transition-colors"
                placeholder="+233-XXX-XXXX"
              />
            </div>
            
            <div>
              <label for="subject" class="block text-sm font-medium text-neutral-700 mb-2">Subject</label>
              <select 
                id="subject" 
                name="subject" 
                required
                class="w-full px-4 py-3 bg-white border border-neutral-200 rounded-lg focus:ring-2 focus:ring-primary-500 focus:border-transparent transition-colors"
              >
                <option value="">Select a subject</option>
                <option value="general">General Inquiry</option>
                <option value="prayer">Prayer Request</option>
                <option value="ministry">Ministry Information</option>
                <option value="pastoral">Pastoral Care</option>
                <option value="volunteer">Volunteer Opportunities</option>
                <option value="events">Events & Programs</option>
                <option value="other">Other</option>
              </select>
            </div>
            
            <div>
              <label for="message" class="block text-sm font-medium text-neutral-700 mb-2">Message</label>
              <textarea 
                id="message" 
                name="message" 
                rows="5" 
                required
                class="w-full px-4 py-3 bg-white border border-neutral-200 rounded-lg focus:ring-2 focus:ring-primary-500 focus:border-transparent transition-colors resize-none"
                placeholder="Please share your message, question, or prayer request..."
              ></textarea>
            </div>
            
            <div class="flex items-start space-x-3">
              <input 
                type="checkbox" 
                id="newsletter" 
                name="newsletter"
                class="mt-1 h-4 w-4 text-primary-600 focus:ring-primary-500 border-neutral-300 rounded"
              />
              <label for="newsletter" class="text-sm text-neutral-600">
                I would like to receive updates about church events and activities via email.
              </label>
            </div>
            
            <button 
              type="submit"
              class="w-full bg-primary-600 text-white font-semibold py-4 px-6 rounded-lg hover:bg-primary-700 focus:ring-2 focus:ring-primary-500 focus:outline-none transition-colors"
            >
              <span class="flex items-center justify-center">
                Send Message
                <svg class="ml-2 w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 19l9 2-9-18-9 18 9-2zm0 0v-8"></path>
                </svg>
              </span>
            </button>
          </form>
        </div>
      </div>
    </div>
  </section>

  <!-- Map Section -->
  <section class="py-20 bg-neutral-50">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-12">
        <h2 class="text-3xl sm:text-4xl font-display font-bold text-neutral-900 mb-4">
          Find Us Here
        </h2>
        <p class="text-xl text-neutral-600">
          We're located in the heart of Kumasi, easily accessible by car or public transport.
        </p>
      </div>
      
      <div class="bg-white rounded-2xl shadow-lg overflow-hidden">
        <!-- Map Placeholder -->
        <div class="h-96 bg-gradient-to-br from-primary-100 to-secondary-100 flex items-center justify-center">
          <div class="text-center">
            <svg class="w-16 h-16 text-primary-600 mx-auto mb-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
            </svg>
            <h3 class="text-xl font-semibold text-neutral-900 mb-2">Interactive Map</h3>
            <p class="text-neutral-600 mb-4">Google Maps integration would be placed here</p>
            <a 
              href="https://maps.google.com/?q=Royal+Cockpit+Hotel+Ahodwo+Nhyiaeso+Kumasi+Ghana" 
              target="_blank"
              class="inline-flex items-center px-6 py-3 bg-primary-600 text-white font-semibold rounded-lg hover:bg-primary-700 transition-colors"
            >
              Open in Google Maps
              <svg class="ml-2 w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"></path>
              </svg>
            </a>
          </div>
        </div>
        
        <!-- Directions -->
        <div class="p-8">
          <h3 class="text-2xl font-semibold text-neutral-900 mb-6">Getting Here</h3>
          <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
            <div>
              <h4 class="text-lg font-medium text-neutral-900 mb-3">By Car</h4>
              <p class="text-neutral-600 mb-4">
                Royal Cockpit Hotel is located in the Ahodwo-Nhyiaeso area of Kumasi. There's ample parking available on the premises.
              </p>
              <div class="text-sm text-neutral-500">
                <p>• Free parking available</p>
                <p>• Accessible entrance</p>
                <p>• Well-lit parking area</p>
              </div>
            </div>
            
            <div>
              <h4 class="text-lg font-medium text-neutral-900 mb-3">By Public Transport</h4>
              <p class="text-neutral-600 mb-4">
                Several public transport options are available to reach the Royal Cockpit Hotel area.
              </p>
              <div class="text-sm text-neutral-500">
                <p>• Accessible by trotro</p>
                <p>• Taxi services available</p>
                <p>• Ride-sharing services</p>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- FAQ Section -->
  <section class="py-20 bg-white">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-16">
        <h2 class="text-3xl sm:text-4xl font-display font-bold text-neutral-900 mb-4">
          Frequently Asked Questions
        </h2>
        <p class="text-xl text-neutral-600">
          Here are some common questions visitors ask about our church.
        </p>
      </div>
      
      <div class="space-y-6">
        <!-- FAQ 1 -->
        <div class="bg-neutral-50 rounded-xl p-6">
          <h3 class="text-lg font-semibold text-neutral-900 mb-3">What should I expect when visiting?</h3>
          <p class="text-neutral-600">
            Expect a warm welcome! Our services are casual and friendly. You can dress comfortably, and we'll have greeters to help you find your way around. Services typically last about 2.5 hours with worship, teaching, and fellowship time.
          </p>
        </div>

        <!-- FAQ 2 -->
        <div class="bg-neutral-50 rounded-xl p-6">
          <h3 class="text-lg font-semibold text-neutral-900 mb-3">Are children welcome?</h3>
          <p class="text-neutral-600">
            Absolutely! We love having families with children. We have programs for different age groups during our Sunday service, and children are always welcome in the main service as well.
          </p>
        </div>

        <!-- FAQ 3 -->
        <div class="bg-neutral-50 rounded-xl p-6">
          <h3 class="text-lg font-semibold text-neutral-900 mb-3">What languages are services conducted in?</h3>
          <p class="text-neutral-600">
            Our main services are conducted in English, with some portions in local languages when appropriate. We aim to make everyone feel welcome regardless of their language background.
          </p>
        </div>

        <!-- FAQ 4 -->
        <div class="bg-neutral-50 rounded-xl p-6">
          <h3 class="text-lg font-semibold text-neutral-900 mb-3">How can I get involved?</h3>
          <p class="text-neutral-600">
            There are many ways to get involved! You can join our various ministries, volunteer for events, participate in small groups, or simply start by attending regularly. We'd love to help you find your place in our community.
          </p>
        </div>
      </div>
    </div>
  </section>

  <Footer />
</Layout>

<script>
  // Contact form handling
  document.getElementById('contact-form')?.addEventListener('submit', function(e) {
    e.preventDefault();
    
    // Show success message (in a real application, this would submit to a server)
    const button = this.querySelector('button[type="submit"]');
    const originalText = button.innerHTML;
    
    button.innerHTML = `
      <span class="flex items-center justify-center">
        <svg class="animate-spin -ml-1 mr-3 h-5 w-5 text-white" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24">
          <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
          <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
        </svg>
        Sending...
      </span>
    `;
    
    // Simulate form submission
    setTimeout(() => {
      button.innerHTML = `
        <span class="flex items-center justify-center">
          <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
          </svg>
          Message Sent!
        </span>
      `;
      
      // Reset form
      this.reset();
      
      // Reset button after 3 seconds
      setTimeout(() => {
        button.innerHTML = originalText;
      }, 3000);
    }, 2000);
  });
</script>
