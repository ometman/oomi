---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import NewsletterSignup from '../components/newsletter/NewsletterSignup.astro';
import YouTubePlayer from '../components/sermons/YouTubePlayer.astro';
import { getPublishedSermons, sermonPlaceholders } from '../data/sermons';

const sermons = getPublishedSermons();
const [featuredSermon, ...archiveSermons] = sermons;
const remainingPlaceholders = sermons.length
  ? sermonPlaceholders.slice(Math.min(sermons.length, sermonPlaceholders.length))
  : [];
const formatDate = (value: string) =>
  new Intl.DateTimeFormat('en-GB', {
    day: 'numeric',
    month: 'long',
    year: 'numeric',
  }).format(new Date(`${value}T12:00:00Z`));
---

<Layout
  title="Sermons and Biblical Teaching | Omet Omeni Ministries"
  description="Watch and listen to approved sermons and biblical teaching from Omet Omeni Ministries, serving Accra, Kumasi and online."
>
  <Header />
  <main>
    <section class="relative isolate overflow-hidden bg-primary-900 py-20 text-white sm:py-24">
      <div class="absolute inset-0 -z-10 bg-[radial-gradient(circle_at_top_right,rgba(251,191,36,0.18),transparent_38%)]" aria-hidden="true"></div>
      <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
        <p class="text-sm font-semibold uppercase tracking-[0.22em] text-secondary-300">Biblical teaching</p>
        <h1 class="mt-4 max-w-4xl text-4xl font-display font-bold sm:text-5xl lg:text-6xl">Messages for faithful Christian growth</h1>
        <p class="mt-6 max-w-3xl text-lg leading-relaxed text-primary-100">Explore ministry-approved sermons that help believers understand Scripture, grow in Christ and live with kingdom purpose.</p>
      </div>
    </section>

    {featuredSermon ? (
      <section class="bg-white py-20 sm:py-24" aria-labelledby="featured-message-heading">
        <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
          <p class="text-sm font-semibold uppercase tracking-[0.2em] text-secondary-700">Latest message</p>
          <article class="mt-6 grid overflow-hidden rounded-3xl border border-neutral-200 bg-neutral-50 shadow-lg lg:grid-cols-[0.95fr_1.05fr]">
            <div class="self-center bg-gradient-to-br from-primary-900 to-neutral-900">
              <YouTubePlayer url={featuredSermon.mediaUrl} title={featuredSermon.title} thumbnail={featuredSermon.thumbnail} eager />
            </div>
            <div class="p-8 sm:p-10">
              <p class="text-sm font-semibold uppercase tracking-wider text-secondary-700">{featuredSermon.series || 'Ministry teaching'}</p>
              <h2 id="featured-message-heading" class="mt-3 text-3xl font-display font-bold text-neutral-900 sm:text-4xl">{featuredSermon.title}</h2>
              <p class="mt-4 text-neutral-500">{featuredSermon.speaker} · {formatDate(featuredSermon.publishedAt)}</p>
              {featuredSermon.scripture && <p class="mt-5 font-semibold text-primary-800">{featuredSermon.scripture}</p>}
              <p class="mt-5 text-lg leading-relaxed text-neutral-600">{featuredSermon.excerpt}</p>
              <a href={featuredSermon.mediaUrl} target="_blank" rel="noopener noreferrer" class="mt-8 inline-flex min-h-12 items-center justify-center rounded-lg bg-primary-800 px-6 py-3 font-semibold text-white hover:bg-primary-900 focus:outline-none focus:ring-2 focus:ring-primary-500 focus:ring-offset-2">
                {featuredSermon.mediaType === 'WATCH' ? 'Watch Message' : 'Listen to Message'}
                <span class="sr-only">: {featuredSermon.title} (opens in a new tab)</span>
              </a>
            </div>
          </article>
        </div>
      </section>
    ) : (
      <section class="bg-white py-20 sm:py-24" aria-labelledby="sermon-empty-heading">
        <div class="mx-auto max-w-4xl px-4 sm:px-6 lg:px-8">
          <div class="text-center">
            <h2 id="sermon-empty-heading" class="text-3xl font-display font-bold text-neutral-900">Message placeholders</h2>
            <p class="mx-auto mt-4 max-w-2xl leading-relaxed text-neutral-700">These slots are ready for approved sermons. Each one will be replaced automatically as real messages are published.</p>
          </div>
          <div class="mt-10 grid gap-6 md:grid-cols-3">
            {sermonPlaceholders.map((placeholder) => (
              <article class="overflow-hidden rounded-2xl border border-neutral-200 bg-white text-left shadow-sm">
                <div class="flex h-44 items-center justify-center bg-gradient-to-br from-primary-900 to-neutral-900 text-secondary-300" aria-hidden="true">
                  <svg class="h-12 w-12" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.4" d="M12 6.253v13m0-13C10.8 5.5 9.2 5 7.5 5S4.2 5.5 3 6.253v13C4.2 18.5 5.8 18 7.5 18s3.3.5 4.5 1.253m0-13C13.2 5.5 14.8 5 16.5 5s3.3.5 4.5 1.253v13C19.8 18.5 18.2 18 16.5 18s-3.3.5-4.5 1.253"></path></svg>
                </div>
                <div class="p-6">
                  <p class="text-xs font-bold uppercase tracking-wider text-secondary-700">{placeholder.label}</p>
                  <h3 class="mt-2 text-xl font-semibold text-neutral-900">{placeholder.title}</h3>
                  <p class="mt-3 text-sm leading-relaxed text-neutral-600">{placeholder.guidance}</p>
                  <span class="mt-5 inline-flex rounded-full bg-neutral-100 px-3 py-1 text-xs font-semibold text-neutral-600">Coming soon</span>
                </div>
              </article>
            ))}
          </div>
          <div class="mt-10 text-center"><a href="#sermon-updates" class="inline-flex font-semibold text-primary-800 underline decoration-secondary-500 underline-offset-4">Subscribe for Teaching Updates</a></div>
        </div>
      </section>
    )}

    {(archiveSermons.length > 0 || remainingPlaceholders.length > 0) && (
      <section class="bg-neutral-50 py-20 sm:py-24" aria-labelledby="sermon-archive-heading">
        <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
          <h2 id="sermon-archive-heading" class="text-3xl font-display font-bold text-neutral-900 sm:text-4xl">Message archive</h2>
          <div class="mt-10 grid gap-6 md:grid-cols-2 lg:grid-cols-3">
            {archiveSermons.map((sermon) => (
              <article class="flex flex-col overflow-hidden rounded-2xl border border-neutral-200 bg-white shadow-sm">
                <div class="bg-gradient-to-br from-primary-900 to-neutral-900">
                  <YouTubePlayer url={sermon.mediaUrl} title={sermon.title} thumbnail={sermon.thumbnail} />
                </div>
                <div class="flex flex-1 flex-col p-6">
                  <p class="text-sm font-semibold text-secondary-700">{sermon.series || 'Ministry teaching'}</p>
                  <h3 class="mt-2 text-xl font-semibold text-neutral-900">{sermon.title}</h3>
                  <p class="mt-2 text-sm text-neutral-500">{sermon.speaker} · {formatDate(sermon.publishedAt)}</p>
                  <p class="mt-4 flex-1 leading-relaxed text-neutral-600">{sermon.excerpt}</p>
                  <a href={sermon.mediaUrl} target="_blank" rel="noopener noreferrer" class="mt-5 font-semibold text-primary-800 underline decoration-secondary-500 underline-offset-4">
                    {sermon.mediaType === 'WATCH' ? 'Watch Message' : 'Listen to Message'}
                    <span class="sr-only">: {sermon.title} (opens in a new tab)</span>
                  </a>
                </div>
              </article>
            ))}
            {remainingPlaceholders.map((placeholder) => (
              <article class="overflow-hidden rounded-2xl border border-dashed border-neutral-300 bg-white shadow-sm">
                <div class="flex h-52 items-center justify-center bg-gradient-to-br from-primary-900 to-neutral-900 text-secondary-300" aria-hidden="true">
                  <svg class="h-12 w-12" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.4" d="M12 6.253v13m0-13C10.8 5.5 9.2 5 7.5 5S4.2 5.5 3 6.253v13C4.2 18.5 5.8 18 7.5 18s3.3.5 4.5 1.253m0-13C13.2 5.5 14.8 5 16.5 5s3.3.5 4.5 1.253v13C19.8 18.5 18.2 18 16.5 18s-3.3.5-4.5 1.253"></path></svg>
                </div>
                <div class="p-6">
                  <p class="text-xs font-bold uppercase tracking-wider text-secondary-700">{placeholder.label}</p>
                  <h3 class="mt-2 text-xl font-semibold text-neutral-900">{placeholder.title}</h3>
                  <p class="mt-3 text-sm leading-relaxed text-neutral-600">{placeholder.guidance}</p>
                  <span class="mt-5 inline-flex rounded-full bg-neutral-100 px-3 py-1 text-xs font-semibold text-neutral-600">Coming soon</span>
                </div>
              </article>
            ))}
          </div>
        </div>
      </section>
    )}

    <section id="sermon-updates" class="bg-neutral-900 py-20 text-white" aria-labelledby="sermon-newsletter-heading">
      <div class="mx-auto max-w-3xl px-4 sm:px-6 lg:px-8">
        <div class="rounded-2xl border border-white/10 bg-white/5 p-7 sm:p-10">
          <NewsletterSignup
            source="SERMONS"
            dark
            title="Get sermon notifications"
            description="Receive new biblical teachings and the ministry updates you select."
            defaultInterests={['SERMONS_TEACHINGS']}
          />
        </div>
      </div>
    </section>
  </main>
  <Footer />
</Layout>
